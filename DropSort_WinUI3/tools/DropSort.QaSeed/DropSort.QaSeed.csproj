<Project Sdk="Microsoft.NET.Sdk">

  <!-- QA only synthetic library seeder. Reuses the production DatabaseMigrator (v13 schema), then bulk
       inserts movies, TV shows, custom lists, membership and watch events with realistic variety.
       Point the installed app at a seeded profile with DROPSORT_TEST_DATA_ROOT. Not shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DropSort.QaSeed</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DropSort.Infrastructure\DropSort.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\DropSort.Application\DropSort.Application.csproj" />
    <ProjectReference Include="..\..\src\DropSort.Domain\DropSort.Domain.csproj" />
  </ItemGroup>

</Project>
