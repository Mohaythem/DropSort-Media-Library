<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DropSort.UI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WindowsPackageType>None</WindowsPackageType>

    <!--
      Desktop app identity for the unpackaged EXE and the installer. There is no authoritative legal
      publisher, so Company/Product use the project name. This is a local release candidate,
      not a stable 1.0 declaration. Numeric file/assembly versions omit the SemVer prerelease suffix.
    -->
    <ApplicationIcon>Assets\DropSort.ico</ApplicationIcon>
    <Product>DropSort</Product>
    <AssemblyTitle>DropSort</AssemblyTitle>
    <Company>DropSort</Company>
    <Authors>DropSort</Authors>
    <Version>0.10.0-rc.3</Version>
    <AssemblyVersion>0.10.0.0</AssemblyVersion>
    <FileVersion>0.10.0.3</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Copyright>Copyright © DropSort</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.260224002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DropSort.Application\DropSort.Application.csproj" />
    <ProjectReference Include="..\DropSort.Infrastructure\DropSort.Infrastructure.csproj" />
    <ProjectReference Include="..\DropSort.FileSystem\DropSort.FileSystem.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\MovieDetails\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
