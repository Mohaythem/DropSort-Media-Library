<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DropSort.UI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WindowsPackageType>None</WindowsPackageType>

    <!--
      Desktop app identity for the unpackaged EXE and the installer. There is no authoritative legal
      publisher, so Company/Product use the project name. The release is an explicit preview
      (0.9.0-preview): roadmap risks remain open, so this is not a public 1.0 declaration. The win32
      file/assembly versions carry the numeric 0.9.0.0; the informational version keeps the -preview tag.
    -->
    <ApplicationIcon>Assets\DropSort.ico</ApplicationIcon>
    <Product>DropSort</Product>
    <AssemblyTitle>DropSort</AssemblyTitle>
    <Company>DropSort</Company>
    <Authors>DropSort</Authors>
    <Version>0.9.0-preview</Version>
    <AssemblyVersion>0.9.0.0</AssemblyVersion>
    <FileVersion>0.9.0.0</FileVersion>
    <Copyright>Copyright © DropSort</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.260224002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DropSort.Application\DropSort.Application.csproj" />
    <ProjectReference Include="..\DropSort.Infrastructure\DropSort.Infrastructure.csproj" />
    <ProjectReference Include="..\DropSort.FileSystem\DropSort.FileSystem.csproj" />
  </ItemGroup>

</Project>
