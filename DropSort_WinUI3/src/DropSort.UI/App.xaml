<Application
    x:Class="DropSort.UI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="using:DropSort.UI.Resources">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Resources/ThemeResources.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />
                <!--  The card dictionary has a code-behind (compiled x:Bind), so it is merged by type.  -->
                <resources:MediaTemplates />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
