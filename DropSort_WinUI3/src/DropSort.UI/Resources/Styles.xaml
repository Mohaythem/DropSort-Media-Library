<!--
    DropSort control styles.

    Every style derives from a native WinUI 3 style (DefaultButtonStyle, AccentButtonStyle,
    the Windows type ramp, ...) so that the built-in PointerOver / Pressed / Disabled /
    Focused visual states, keyboard handling and accessibility behaviour are preserved.
    Geometry comes from ControlCornerRadius / OverlayCornerRadius, never from scattered
    literal radii.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Text.

        LineHeight is set together with LineStackingStrategy="MaxHeight": the Latin type ramp
        derives its line box from the primary font, which is tighter than the ascent an Arabic
        fallback font needs, so a shadda or a tanween was being cut flat at the top of a caption.
        MaxHeight makes the line box the larger of this value and what the glyphs actually
        measure, so the box can only ever grow - Latin keeps its ramp, Arabic stops clipping.
    -->
    <Style x:Key="SecondaryBodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="LineStackingStrategy" Value="MaxHeight" />
    </Style>
    <Style x:Key="SecondaryCaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="LineStackingStrategy" Value="MaxHeight" />
    </Style>
    <Style x:Key="TertiaryCaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="LineStackingStrategy" Value="MaxHeight" />
    </Style>

    <!--  Buttons  -->
    <Style x:Key="SubtleControlButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,4,12,4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="AccentControlButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,4,12,4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="ActiveControlButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleControlButtonStyle}">
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AccentControlBorderBrush}" />
    </Style>
    <Style x:Key="DangerControlButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleControlButtonStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        <Setter Property="Background" Value="{ThemeResource DangerControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DangerControlBorderBrush}" />
    </Style>
    <Style x:Key="TextActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="8,4,8,4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="IconActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="SubtleIconActionButtonStyle" TargetType="Button" BasedOn="{StaticResource IconActionButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="BackNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource TextActionButtonStyle}">
        <Setter Property="Margin" Value="0,0,0,24" />
    </Style>
    <!--
        A whole card that is clickable. Only Background / BorderBrush / geometry are set, so the
        native PointerOver / Pressed / Disabled visual states (which target ContentPresenter and
        therefore win over style setters) still light up.
    -->
    <Style x:Key="CardActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
    </Style>

    <!--  Surfaces  -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="DangerCardBorderStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="BorderBrush" Value="{ThemeResource DangerCardStrokeBrush}" />
    </Style>
    <Style x:Key="ListSurfaceBorderStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="HairlineDividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="RowDividerStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="12,8,12,8" />
    </Style>
    <Style x:Key="StatusPillStyle" TargetType="Border">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="8,0,8,0" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="GenreChipStyle" TargetType="Border" BasedOn="{StaticResource StatusPillStyle}">
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="PosterSurfaceStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{ThemeResource PosterMoviePlaceholderBrush}" />
    </Style>
    <Style x:Key="ShowPosterSurfaceStyle" TargetType="Border" BasedOn="{StaticResource PosterSurfaceStyle}">
        <Setter Property="Background" Value="{ThemeResource PosterShowPlaceholderBrush}" />
    </Style>
    <Style x:Key="TileSurfaceStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
    </Style>

    <!--  Inputs  -->
    <!--
        The query icon is NOT set here. A Setter value is instantiated once and shared by every
        control the style is applied to, and QueryIcon is a UIElement: the first search box to load
        parents that single IconElement, and the next one to load fails with "Element is already the
        child of another element", which the XAML core turns into a process kill. Each search box
        therefore declares QueryIcon="Find" on the element itself, which gives it its own instance.

        Width is structural, not a literal: the box stretches to fill its host column, and each page
        puts it in a single star column capped at PageSearchMaxWidth. That gives the designed ~320
        epx on a normal desktop, shrinks with the column on a narrow window, and starts at the
        leading edge in both LTR and RTL without a margin.
    -->
    <Style x:Key="PageSearchBoxStyle" TargetType="AutoSuggestBox">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <!--
            Control.HorizontalContentAlignment defaults to Center, and AutoSuggestBox passes it
            through to its inner TextBox, so without this the query text and the placeholder sit in
            the middle of the box instead of on the leading edge.
        -->
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="{StaticResource ControlRowHeight}" />
    </Style>
    <Style x:Key="FormInputTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="{StaticResource ControlRowHeight}" />
    </Style>
    <Style x:Key="FormInputPasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="Height" Value="{StaticResource ControlRowHeight}" />
    </Style>
    <Style x:Key="NarrowSelectStyle" TargetType="ComboBox">
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!--
        Tab strip (page-level filter tabs).

        Grouped RadioButtons rather than SelectorBar: the tab labels are re-localized at runtime, and
        a RadioButton's label is a plain Content property, while a SelectorBarItem is a data item of
        the ItemsView inside the bar's template, so keeping localized labels in sync there means
        touching a virtualizing collection. Selection, keyboard handling and accessibility come from
        the framework (this is the same primitive the WinUI RadioButtons control is built from), and
        the template below carries the selection visual SelectorBar draws: transparent rest state,
        subtle hover fill and a 2 epx accent underline on the selected tab. Hover lives in
        CommonStates and selection in CheckStates, so the two compose without a state matrix.
    -->
    <Style x:Key="TabStripStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="TabStripItemStyle" TargetType="RadioButton">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,0,12,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid
                        x:Name="TabRoot"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="TabRoot.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        <Setter Target="TabContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="TabRoot.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        <Setter Target="TabContent.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="TabContent.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                        <Setter Target="TabIndicator.Background" Value="{ThemeResource AccentFillColorDisabledBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="TabContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <Setter Target="TabIndicator.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <ContentPresenter
                            x:Name="TabContent"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            TextWrapping="NoWrap" />

                        <Border
                            x:Name="TabIndicator"
                            Height="2"
                            Margin="10,0,10,0"
                            VerticalAlignment="Bottom"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="1"
                            Opacity="0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Page scaffolding  -->
    <Style x:Key="PageScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="{StaticResource PageContentPadding}" />
        <Setter Property="HorizontalScrollMode" Value="Disabled" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollMode" Value="Enabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <!--
        Media card container.

        The default GridViewItem presenter paints its hover / selected fill *behind* the content, so
        on a media card the opaque poster swallowed it and only the title strip appeared to light up.
        This template moves the state visual to a Border that wraps the whole card - poster and title
        together - and expresses it as a 2 epx stroke plus a subtle fill, with 4 epx of padding so the
        stroke sits just outside the poster instead of on top of it. Every brush is a Fluent theme
        resource (SubtleFill* for hover/press, AccentFillColorDefault for selection), the radius is
        the framework's OverlayCornerRadius, and the state names are the ones GridViewItem's own
        state machine drives, so hover / pressed / selected / disabled all keep working and the
        keyboard focus rectangle is still drawn by the system.
    -->
    <Style x:Key="MediaGridViewItemStyle" TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
        <Setter Property="Margin" Value="0,0,8,16" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewItem">
                    <Border
                        x:Name="CardRoot"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="2"
                        CornerRadius="{ThemeResource OverlayCornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="CardRoot.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        <Setter Target="CardRoot.BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                                        <Setter Target="CardOverlay.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="CardRoot.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        <Setter Target="CardRoot.BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                                        <Setter Target="CardOverlay.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        <Setter Target="CardContent.Opacity" Value="0.85" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="CardRoot.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        <Setter Target="CardRoot.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <Setter Target="CardOverlay.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOverSelected">
                                    <VisualState.Setters>
                                        <Setter Target="CardRoot.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        <Setter Target="CardRoot.BorderBrush" Value="{ThemeResource AccentFillColorSecondaryBrush}" />
                                        <Setter Target="CardOverlay.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PressedSelected">
                                    <VisualState.Setters>
                                        <Setter Target="CardRoot.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        <Setter Target="CardRoot.BorderBrush" Value="{ThemeResource AccentFillColorTertiaryBrush}" />
                                        <Setter Target="CardOverlay.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        <Setter Target="CardContent.Opacity" Value="0.85" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="CardContent.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!--
                            The state fill is painted twice on purpose. CardRoot paints behind the
                            content, which only shows in the 4 epx outer spacing and around the title,
                            and an opaque poster hides the rest - that is what made hover read as
                            "only the title lights up". CardOverlay is the same Fluent subtle-fill
                            token painted *over* the whole content box, so poster and title light up
                            together as one card. It never takes input.
                        -->
                        <Grid>
                            <ContentPresenter
                                x:Name="CardContent"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                            <Border
                                x:Name="CardOverlay"
                                Margin="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="MediaGridViewStyle" TargetType="GridView">
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource MediaGridViewItemStyle}" />
        <Setter Property="IsItemClickEnabled" Value="True" />
        <Setter Property="SelectionMode" Value="None" />
        <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
</ResourceDictionary>
