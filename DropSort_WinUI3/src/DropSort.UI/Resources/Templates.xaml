<!--
    Shared media card templates. Every media grid in the app renders through these, so a card looks
    identical on Home, Library, My Lists and any search result. Movie cards stay poster + title only.

    One poster viewport for the poster-grid templates: MediaCardPosterWidth x MediaCardPosterHeight (180 x 270 epx,
    the 2:3 poster ratio), fixed on both axes. A real poster is drawn into it with UniformToFill and
    clipped by the surface's corner radius; when there is none the placeholder glyph shows through the
    same rectangle, so a card never changes size depending on whether artwork exists.
-->
<ResourceDictionary
    x:Class="DropSort.UI.Resources.MediaTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DropSort.UI.Models">

    <DataTemplate x:Key="MovieCardTemplate" x:DataType="models:MovieRecord">
        <StackPanel Spacing="8">
            <Border
                Width="{StaticResource MediaCardPosterWidth}"
                Height="{StaticResource MediaCardPosterHeight}"
                HorizontalAlignment="Left"
                Style="{StaticResource PosterSurfaceStyle}">
                <Grid>
                    <Image Source="{x:Bind PosterSource, Mode=OneWay}" Stretch="UniformToFill" />
                    <!--
                        Graceful fallback when there is no poster/metadata: an inset, bordered panel that
                        shows the title clearly inside the poster area. The margin keeps the border off the
                        card edges; theme brushes keep it readable in light and dark. Not an error state.
                    -->
                    <Border
                        Margin="12"
                        Background="{ThemeResource LayerFillColorAltBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Padding="12"
                        Visibility="{x:Bind IsPosterMissing, Mode=OneWay}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxLines="4"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Title}"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                    </Border>
                    <!--
                        Subtle multi-file badge: shown only when the movie owns more than one local file
                        (multiple versions/copies). The per-file detail lives in Movie Details.
                    -->
                    <Border
                        Margin="8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource LayerFillColorAltBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Padding="8,2,8,2"
                        Visibility="{x:Bind MultiFileBadgeVisibility, Mode=OneWay}">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind MultiFileBadgeText, Mode=OneWay}" />
                    </Border>
                    <!--
                        "Review match" badge: metadata is present but was auto-picked from a close match, so
                        a glance is recommended. Distinct from a no-metadata card.
                    -->
                    <Border
                        Margin="8"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource LayerFillColorAltBrush}"
                        BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Padding="8,2,8,2"
                        Visibility="{x:Bind ReviewMatchBadgeVisibility, Mode=OneWay}">
                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ReviewMatchLabel, Mode=OneWay}" />
                    </Border>
                </Grid>
            </Border>
            <TextBlock
                Height="{StaticResource MediaCardTitleHeight}"
                MaxLines="2"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind Title}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ShowCardTemplate" x:DataType="models:ShowCardItem">
        <StackPanel Spacing="8">
            <Border
                Width="{StaticResource MediaCardPosterWidth}"
                Height="{StaticResource MediaCardPosterHeight}"
                HorizontalAlignment="Left"
                Style="{StaticResource ShowPosterSurfaceStyle}">
                <Grid>
                    <Image Source="{x:Bind PosterSource, Mode=OneWay}" Stretch="UniformToFill" />
                    <FontIcon
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="40"
                        Foreground="{ThemeResource PosterGlyphForegroundBrush}"
                        Glyph="&#xE7F4;"
                        Visibility="{x:Bind IsPosterMissing, Mode=OneWay}" />
                </Grid>
            </Border>
            <StackPanel Spacing="2">
                <TextBlock
                    Height="{StaticResource MediaCardTitleHeight}"
                    MaxLines="2"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind Title}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
                <TextBlock
                    Style="{StaticResource SecondaryCaptionTextStyle}"
                    Text="{x:Bind SecondaryLine}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="HorizontalMovieCardTemplate" x:DataType="models:MovieRecord">
        <Border CornerRadius="{ThemeResource ControlCornerRadius}">
            <Grid Background="{ThemeResource PosterMoviePlaceholderBrush}">
                <FontIcon Margin="0,0,0,60" FontSize="36" Glyph="&#xE8B2;"
                          Foreground="{ThemeResource PosterGlyphForegroundBrush}" />
                <Image Source="{x:Bind HorizontalArtworkSource, Mode=OneWay}" Stretch="UniformToFill" FlowDirection="LeftToRight" />
                <Image Width="88" Height="132" Margin="12,8,12,0"
                       HorizontalAlignment="Right" VerticalAlignment="Top"
                       Source="{x:Bind PosterSource, Mode=OneWay}" Stretch="Uniform"
                       Visibility="{x:Bind HorizontalPosterVisibility, Mode=OneWay}" FlowDirection="LeftToRight" />
                <Border Background="{ThemeResource LandscapeCardScrimBrush}" />
                <Border Margin="12" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Background="{ThemeResource LayerFillColorAltBrush}"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Visibility="{x:Bind ReviewMatchBadgeVisibility, Mode=OneWay}">
                    <TextBlock Foreground="{ThemeResource SystemFillColorCautionBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ReviewMatchLabel}"
                               TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ReviewMatchLabel}" />
                </Border>
                <StackPanel Margin="14" VerticalAlignment="Bottom" Spacing="2">
                    <TextBlock Foreground="{ThemeResource LandscapeCardTextBrush}"
                               Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}"
                               MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                               ToolTipService.ToolTip="{x:Bind Title}" />
                    <TextBlock Foreground="{ThemeResource LandscapeCardSecondaryTextBrush}"
                               Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind YearText}"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Visibility="{x:Bind YearVisibility}" />
                    <TextBlock Foreground="{ThemeResource LandscapeCardSecondaryTextBrush}"
                               Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind HorizontalSummaryLine}"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="HorizontalShowCardTemplate" x:DataType="models:ShowCardItem">
        <Border CornerRadius="{ThemeResource ControlCornerRadius}">
            <Grid Background="{ThemeResource PosterShowPlaceholderBrush}">
                <FontIcon Margin="0,0,0,60" FontSize="36" Glyph="&#xE7F4;"
                          Foreground="{ThemeResource PosterGlyphForegroundBrush}" />
                <Image Source="{x:Bind HorizontalArtworkSource, Mode=OneWay}" Stretch="UniformToFill" FlowDirection="LeftToRight" />
                <Image Width="88" Height="132" Margin="12,8,12,0"
                       HorizontalAlignment="Right" VerticalAlignment="Top"
                       Source="{x:Bind PosterSource, Mode=OneWay}" Stretch="Uniform"
                       Visibility="{x:Bind HorizontalPosterVisibility, Mode=OneWay}" FlowDirection="LeftToRight" />
                <Border Background="{ThemeResource LandscapeCardScrimBrush}" />
                <Border Margin="12" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Background="{ThemeResource ArtworkBadgeBackgroundBrush}"
                        CornerRadius="{ThemeResource ControlCornerRadius}" FlowDirection="LeftToRight">
                    <TextBlock Foreground="{ThemeResource ArtworkBadgeForegroundBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind LocalEpisodesLine}"
                               TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind LocalEpisodesLine}" />
                </Border>
                <StackPanel Margin="14" VerticalAlignment="Bottom" Spacing="2">
                    <TextBlock Foreground="{ThemeResource LandscapeCardTextBrush}"
                               Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}"
                               MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                               ToolTipService.ToolTip="{x:Bind Title}" />
                    <TextBlock Foreground="{ThemeResource LandscapeCardSecondaryTextBrush}"
                               Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind YearText}"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Visibility="{x:Bind YearVisibility}" />
                    <TextBlock Foreground="{ThemeResource LandscapeCardSecondaryTextBrush}"
                               Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind SeasonLine}" Margin="0,0,100,0"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="ListMovieCardTemplate" x:DataType="models:ListMediaItem">
        <StackPanel Spacing="8">
            <Border
                Width="{StaticResource MediaCardPosterWidth}"
                Height="{StaticResource MediaCardPosterHeight}"
                HorizontalAlignment="Left"
                Style="{StaticResource PosterSurfaceStyle}">
                <Grid>
                    <Border Margin="8" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="{ThemeResource LayerFillColorAltBrush}"
                            CornerRadius="{ThemeResource ControlCornerRadius}" Canvas.ZIndex="1">
                        <TextBlock Text="{x:Bind TypeLabel}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Border>
                    <Image Source="{x:Bind PosterSource, Mode=OneWay}" Stretch="UniformToFill" />
                    <!-- Graceful no-poster fallback: inset bordered title panel (see MovieCardTemplate). -->
                    <Border
                        Margin="12"
                        Background="{ThemeResource LayerFillColorAltBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Padding="12"
                        Visibility="{x:Bind IsPosterMissing, Mode=OneWay}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxLines="4"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Title}"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                    </Border>
                    <Border
                        MinHeight="20"
                        Margin="8"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource LayerFillColorAltBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Padding="8,0,8,0"
                        Visibility="{x:Bind ShowLocalBadge}">
                        <Grid>
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind LocalBadgeText}"
                                Visibility="{x:Bind IsLocal}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind LocalBadgeText}"
                                Visibility="{x:Bind IsRemote}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <TextBlock
                Height="{StaticResource MediaCardTitleHeight}"
                MaxLines="2"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind Title}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
