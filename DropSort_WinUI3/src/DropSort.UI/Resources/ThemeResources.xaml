<!--
    DropSort semantic resource layer.

    Everything a native WinUI 3 ThemeResource already provides is consumed directly by the
    views (TextFillColorPrimaryBrush, CardBackgroundFillColorDefaultBrush, ControlCornerRadius,
    OverlayCornerRadius, the Windows type ramp, ...). This dictionary only adds the handful of
    application-level semantic values that have no built-in equivalent: the shared page
    geometry constants, the poster placeholder surfaces, the destructive-action tints and the
    optional Slate background tint.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared page geometry (effective pixels, 4 epx grid). -->
    <x:Double x:Key="PageContentMaxWidth">1040</x:Double>
    <x:Double x:Key="PageSearchMaxWidth">320</x:Double>
    <x:Double x:Key="AddMediaContentMaxWidth">1120</x:Double>
    <x:Double x:Key="CheckLibraryContentMaxWidth">640</x:Double>
    <x:Double x:Key="CheckLibraryWideMaxWidth">760</x:Double>
    <x:Double x:Key="ProseMaxWidth">760</x:Double>
    <x:Double x:Key="EmptyStateMaxWidth">560</x:Double>
    <x:Double x:Key="FileDetailsFlyoutWidth">420</x:Double>
    <x:Double x:Key="ControlRowHeight">36</x:Double>
    <x:Double x:Key="CompactControlHeight">32</x:Double>

    <!--
        Media card geometry. One poster viewport for the whole app: 180 x 270 epx, the exact 2:3
        poster ratio, declared on both axes so a real image (UniformToFill) and the missing-poster
        placeholder occupy the identical rectangle on Home, Library, My Lists and every search
        result. The title reserves two lines of the BodyStrong ramp (2 x 20 epx) so every row lines
        up whether a title wraps or not.

        Cell size = card + the item container's chrome. The container adds 4 epx padding on each
        side (the outer spacing the selection stroke sits in) plus its 2 epx stroke, so 12 epx on
        each axis, then the inter-card gutter (8 epx across, 16 epx down).
    -->
    <x:Double x:Key="MediaCardPosterWidth">180</x:Double>
    <x:Double x:Key="MediaCardPosterHeight">270</x:Double>
    <x:Double x:Key="MediaCardTitleHeight">40</x:Double>
    <x:Double x:Key="MediaCardItemWidth">200</x:Double>
    <x:Double x:Key="MediaCardItemHeight">346</x:Double>
    <x:Double x:Key="ShowCardItemHeight">364</x:Double>
    <x:Double x:Key="DetailsPosterWidth">180</x:Double>
    <x:Double x:Key="DetailsPosterHeight">270</x:Double>

    <Thickness x:Key="PageContentPadding">32,32,32,48</Thickness>
    <Thickness x:Key="PageContentPaddingCompact">24,24,24,40</Thickness>

    <!--
        Shell surfaces and NavigationView selected-state strength.

        The shell reads as two layers: the pane is the receding surface and the content area is the
        elevated one, so ShellPaneBackgroundBrush darkens what is behind it and
        ShellContentBackgroundBrush lifts it. Both are neutral overlays rather than opaque colours,
        which is what keeps the pair theme-aware: the same two values sit on the Light surface, the
        Dark surface and the Slate tint, so Slate stays slate-tinted instead of collapsing onto a
        hard-coded panel colour. NavigationView's own pane brushes are Transparent here on purpose -
        the pane surface comes from the control's Background (see MainWindow.xaml), so there is one
        source of truth per theme.

        The rest are NavigationView's own lightweight-styling keys, overridden application-wide so
        the shell keeps the stock template, the stock accent selection indicator
        (NavigationViewSelectionIndicatorForeground is deliberately NOT overridden - the default
        already is AccentFillColorDefaultBrush) and every stock hover, pressed and focus visual. The
        fill behind the active item is a light overlay in the dark themes and a dark one in Light, so
        it keeps reading as a plate now that the pane underneath it is the darkest shell surface.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="ShellPaneBackgroundBrush" Color="#3D000000" />
            <SolidColorBrush x:Key="ShellContentBackgroundBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="ShellPaneSeparatorBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />

            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#40FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#4DFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#FFFFFFFF" />

            <LinearGradientBrush x:Key="PosterMoviePlaceholderBrush" StartPoint="0,0" EndPoint="0.85,1">
                <GradientStop Offset="0" Color="#FF3A5866" />
                <GradientStop Offset="1" Color="#FF2B2B2B" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PosterShowPlaceholderBrush" StartPoint="0,0" EndPoint="0.85,1">
                <GradientStop Offset="0" Color="#FF46425D" />
                <GradientStop Offset="1" Color="#FF2B2B2B" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="PosterGlyphForegroundBrush" Color="#61FFFFFF" />
            <SolidColorBrush x:Key="SlateBackgroundBrush" Color="#FF1F2933" />
            <SolidColorBrush x:Key="DangerControlBackgroundBrush" Color="#14FF99A4" />
            <SolidColorBrush x:Key="DangerControlBorderBrush" Color="#61FF99A4" />
            <SolidColorBrush x:Key="DangerCardStrokeBrush" Color="#61FF99A4" />
            <SolidColorBrush x:Key="AccentControlBorderBrush" Color="#7A60CDFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ShellPaneBackgroundBrush" Color="#17000000" />
            <SolidColorBrush x:Key="ShellContentBackgroundBrush" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="ShellPaneSeparatorBrush" Color="#1F000000" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />

            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#24000000" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#2E000000" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#1A000000" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#0F000000" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#0A000000" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#E4000000" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#E4000000" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#E4000000" />

            <LinearGradientBrush x:Key="PosterMoviePlaceholderBrush" StartPoint="0,0" EndPoint="0.85,1">
                <GradientStop Offset="0" Color="#FFB9D4EB" />
                <GradientStop Offset="1" Color="#FFFAFAFA" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PosterShowPlaceholderBrush" StartPoint="0,0" EndPoint="0.85,1">
                <GradientStop Offset="0" Color="#FFE2DDFA" />
                <GradientStop Offset="1" Color="#FFFAFAFA" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="PosterGlyphForegroundBrush" Color="#72000000" />
            <SolidColorBrush x:Key="SlateBackgroundBrush" Color="#FFF3F3F3" />
            <SolidColorBrush x:Key="DangerControlBackgroundBrush" Color="#14C42B1C" />
            <SolidColorBrush x:Key="DangerControlBorderBrush" Color="#61C42B1C" />
            <SolidColorBrush x:Key="DangerCardStrokeBrush" Color="#61C42B1C" />
            <SolidColorBrush x:Key="AccentControlBorderBrush" Color="#7A0067C0" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="ShellPaneBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ShellContentBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ShellPaneSeparatorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />

            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />

            <SolidColorBrush x:Key="PosterMoviePlaceholderBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="PosterShowPlaceholderBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="PosterGlyphForegroundBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="SlateBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DangerControlBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="DangerControlBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="DangerCardStrokeBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="AccentControlBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
