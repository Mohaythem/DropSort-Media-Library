<Window
    x:Class="DropSort.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DropSort Media Library">

    <!--
        Shell root. The window paints one background; the navigation pane and the content area are
        both transparent so a theme change only has to swap this single brush. Page padding lives
        on each page's ScrollViewer (PageScrollViewerStyle) - never on the shell - so nothing can
        shift the content right or push a search box outside the viewport.

        The background is a {ThemeResource}, so Light and Dark are handled by the framework the
        moment RootGrid.RequestedTheme changes. Code must never assign this brush: resolving
        ApplicationPageBackgroundThemeBrush from Application.Resources in code returns the brush for
        the *process* theme, which is what used to leave the whole shell dark behind light-themed
        controls when Light was selected. The Slate theme is a tint drawn on top instead (see
        SlateSurface), so it needs no code-resolved brush either.
    -->
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ShellWidthStates">
                <VisualState x:Name="ShellWideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ShellNavigation.OpenPaneLength" Value="272" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ShellMediumState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ShellNavigation.OpenPaneLength" Value="224" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!--
            The Slate theme, exactly like the design's [data-theme='slate'] rule, is the dark palette
            with a cooler shell tint - so it is one opaque surface drawn under everything and never
            takes input. Visibility is the only thing the theme code touches.
        -->
        <Border
            x:Name="SlateSurface"
            Grid.RowSpan="2"
            Background="{ThemeResource SlateBackgroundBrush}"
            IsHitTestVisible="False"
            Visibility="Collapsed" />

        <!--
            The caption buttons are always drawn top-right by Windows, so this row stays
            left-to-right in every language and only the brand name (never translated) sits in it.
        -->
        <Grid
            x:Name="TitleBarDragRegion"
            Background="Transparent"
            FlowDirection="LeftToRight">
            <StackPanel
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <FontIcon
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="14"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="&#xE714;" />
                <TextBlock
                    x:Name="WindowTitleText"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="DropSort" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="ShellNavigation"
            Grid.Row="1"
            Background="Transparent"
            CompactModeThresholdWidth="0"
            CompactPaneLength="64"
            ExpandedModeThresholdWidth="820"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="True"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="272"
            PaneDisplayMode="Left"
            SelectionChanged="ShellNavigation_SelectionChanged">

            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>

                <!--
                    Selected-state strength (the active page used to read as "nothing is selected" on
                    this transparent pane) is set by overriding NavigationView's own lightweight-styling
                    brush keys - NavigationViewItemBackgroundSelected and friends - in
                    ThemeResources.xaml, inside ResourceDictionary.ThemeDictionaries. They cannot live
                    here: a {ThemeResource} colour reference is only resolvable from inside a theme
                    dictionary, and declaring these brushes in this plain dictionary took the whole XAML
                    load down at startup (STATUS_STOWED_EXCEPTION, before the managed handler runs).
                -->

                <Style TargetType="NavigationViewItem">
                    <Setter Property="MinHeight" Value="40" />
                </Style>
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeNavItem" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="LibraryNavItem" Tag="library">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="MyListsNavItem" Tag="lists">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="AddMediaNavItem" Tag="add">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE710;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="CheckLibraryNavItem" Tag="check">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE73E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="SettingsNavItem" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!--
                Every page is parented here once and navigation only flips Visibility, so page state
                (scroll offset, selected tab, typed search text) survives navigation and no page is
                ever torn down and rebuilt. Only one page is Visible at a time; the collapsed ones
                cost no layout and are skipped by the tab order.
            -->
            <Grid x:Name="ContentHost" />
        </NavigationView>
    </Grid>

</Window>
