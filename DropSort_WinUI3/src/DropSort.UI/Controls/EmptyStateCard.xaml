<UserControl
    x:Class="DropSort.UI.Controls.EmptyStateCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Left">

    <Border
        MaxWidth="{StaticResource EmptyStateMaxWidth}"
        Style="{StaticResource CardBorderStyle}">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Width="36"
                Height="36"
                VerticalAlignment="Top"
                Style="{StaticResource TileSurfaceStyle}">
                <FontIcon
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="16"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="{x:Bind Glyph, Mode=OneWay}" />
            </Border>

            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind Title, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Style="{StaticResource SecondaryBodyTextStyle}"
                    Text="{x:Bind Message, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <Button
                    Margin="0,8,0,0"
                    Click="ActionButton_Click"
                    Content="{x:Bind ActionText, Mode=OneWay}"
                    Style="{StaticResource SubtleControlButtonStyle}"
                    Visibility="{x:Bind IsActionVisible, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
