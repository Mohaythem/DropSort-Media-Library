<!--
    Movie details.

    Mirrors the design source (MovieDetails.tsx / index.css): hero band with a 2:3 poster and a
    760 px copy column, primary actions plus an ellipsis file-details flyout, then one full width
    "Your Activity" card holding Preference / Watchlist / Watching / Watched date and the watch
    history list. Width response is declarative (VisualStateManager + AdaptiveTrigger); there is no
    SizeChanged re-gridding and no ActualWidth binding.
-->
<Page
    x:Class="DropSort.UI.Views.MovieDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DropSort.UI.Models"
    Background="Transparent">

    <ScrollViewer x:Name="Root" Style="{StaticResource PageScrollViewerStyle}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="DetailsWidthStates">
                <!--  Wide: the 2 x 2 activity grid from the design.  -->
                <VisualState x:Name="DetailsWideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1180" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PreferenceGroup.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="WatchlistGroup.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="WatchlistGroup.(Grid.Row)" Value="0" />
                        <Setter Target="WatchlistGroup.(Grid.Column)" Value="1" />
                        <Setter Target="WatchlistGroup.Margin" Value="24,0,0,0" />
                        <Setter Target="WatchingGroup.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="WatchingGroup.(Grid.Row)" Value="1" />
                        <Setter Target="WatchedDateGroup.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="WatchedDateGroup.(Grid.Row)" Value="1" />
                        <Setter Target="WatchedDateGroup.(Grid.Column)" Value="1" />
                        <Setter Target="WatchedDateGroup.Margin" Value="24,24,0,0" />
                    </VisualState.Setters>
                </VisualState>
                <!--  Medium and up: the values written in the markup below (action row on one line).  -->
                <VisualState x:Name="DetailsMediumState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="820" />
                    </VisualState.StateTriggers>
                </VisualState>
                <!--
                    Narrow: the copy column no longer fits four controls beside the poster, so the
                    action row stacks. This is the only width where it is not horizontal.
                -->
                <VisualState x:Name="DetailsCompactState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ActionsPanel.Orientation" Value="Vertical" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    x:Name="ContentColumn"
                    Width="*"
                    MaxWidth="{StaticResource PageContentMaxWidth}" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <Button
                    x:Name="BackButton"
                    Click="BackButton_Click"
                    Style="{StaticResource BackNavigationButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="14"
                            Glyph="&#xE72B;"
                            MirroredWhenRightToLeft="True" />
                        <TextBlock x:Name="BackText" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!--  Hero band: poster + copy column, closed by a hairline.  -->
                <Border
                    BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,0,0,24">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition
                                x:Name="HeroCopyColumn"
                                Width="*"
                                MaxWidth="{StaticResource ProseMaxWidth}" />
                        </Grid.ColumnDefinitions>

                        <!--
                            Same 2:3 viewport as every card in the app (DetailsPoster* = 180 x 270),
                            so the hero artwork and a grid poster are one shape at one size.
                        -->
                        <Border
                            x:Name="PosterSurface"
                            Width="{StaticResource DetailsPosterWidth}"
                            Height="{StaticResource DetailsPosterHeight}"
                            VerticalAlignment="Top"
                            Style="{StaticResource PosterSurfaceStyle}">
                            <Grid>
                                <Image x:Name="PosterImage" Stretch="UniformToFill" />
                                <FontIcon
                                    x:Name="PosterGlyph"
                                    FontSize="40"
                                    Foreground="{ThemeResource PosterGlyphForegroundBrush}"
                                    Glyph="&#xE714;" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock x:Name="KindText" Style="{StaticResource SecondaryCaptionTextStyle}" />
                            <TextBlock
                                x:Name="MovieTitleText"
                                Style="{StaticResource TitleTextBlockStyle}"
                                TextWrapping="Wrap" />
                            <TextBlock x:Name="MovieMetaText" Style="{StaticResource SecondaryBodyTextStyle}" />
                            <TextBlock
                                x:Name="OriginalTitleText"
                                Style="{StaticResource SecondaryCaptionTextStyle}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />

                            <ItemsRepeater x:Name="GenresRepeater">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Style="{StaticResource GenreChipStyle}">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                            <!--
                                Play / Open folder / Organize / ellipsis sit on one row beside the
                                poster and the movie information; only the narrow visual state above
                                stacks them, because four controls do not fit in the copy column
                                there.
                            -->
                            <StackPanel
                                x:Name="ActionsPanel"
                                Margin="0,4,0,0"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    x:Name="PlayButton"
                                    Click="PlayButton_Click"
                                    Style="{StaticResource AccentControlButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Glyph="&#xE768;" />
                                        <TextBlock x:Name="PlayText" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="OpenFolderButton"
                                    Click="OpenFolderButton_Click"
                                    Style="{StaticResource SubtleControlButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Glyph="&#xE8B7;" />
                                        <TextBlock x:Name="OpenFolderText" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="OrganizeButton"
                                    Click="OrganizeButton_Click"
                                    Style="{StaticResource SubtleControlButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <!--
                                            The glyph and the ring share the same slot: a real move can
                                            take minutes on another volume, so the button reports that it
                                            is working instead of looking idle while the page waits.
                                        -->
                                        <FontIcon
                                            x:Name="OrganizeGlyph"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Glyph="&#xE8AB;" />
                                        <ProgressRing
                                            x:Name="OrganizeProgress"
                                            Width="14"
                                            Height="14"
                                            VerticalAlignment="Center"
                                            IsActive="False"
                                            Visibility="Collapsed" />
                                        <TextBlock x:Name="OrganizeText" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="MatchButton"
                                    Click="MatchButton_Click"
                                    Style="{StaticResource SubtleControlButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon
                                            x:Name="MatchGlyph"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Glyph="&#xE721;" />
                                        <ProgressRing
                                            x:Name="MatchProgress"
                                            Width="14"
                                            Height="14"
                                            VerticalAlignment="Center"
                                            IsActive="False"
                                            Visibility="Collapsed" />
                                        <TextBlock x:Name="MatchText" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="MoreButton" Style="{StaticResource SubtleIconActionButtonStyle}">
                                    <FontIcon FontSize="16" Glyph="&#xE712;" />
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom">
                                            <StackPanel Width="{StaticResource FileDetailsFlyoutWidth}" Spacing="12">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        x:Name="FileDetailsTitleText"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                    <Border
                                                        x:Name="PresentPill"
                                                        Grid.Column="1"
                                                        Style="{StaticResource StatusPillStyle}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon
                                                                VerticalAlignment="Center"
                                                                FontSize="12"
                                                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                                Glyph="&#xE73E;" />
                                                            <TextBlock
                                                                x:Name="PresentText"
                                                                VerticalAlignment="Center"
                                                                Style="{StaticResource CaptionTextBlockStyle}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                                <StackPanel x:Name="FilePresentPanel" Spacing="4">
                                                    <TextBlock
                                                        x:Name="FileNameText"
                                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        x:Name="FilePathText"
                                                        IsTextSelectionEnabled="True"
                                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        x:Name="FileFactsText"
                                                        Style="{StaticResource TertiaryCaptionTextStyle}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel
                                                    x:Name="NoFilePanel"
                                                    Spacing="4"
                                                    Visibility="Collapsed">
                                                    <TextBlock
                                                        x:Name="NoFileText"
                                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        x:Name="NoFileHelpText"
                                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>

                            <!--  Overview, separated by a hairline like .overview-block in the design.  -->
                            <Border
                                Margin="0,4,0,0"
                                BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="0,12,0,0">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="OverviewTitleText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        x:Name="OverviewText"
                                        MaxWidth="{StaticResource ProseMaxWidth}"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource SecondaryBodyTextStyle}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Margin="0,32,0,0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="ActivityTitleText" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                x:Name="ActivityHelpText"
                                Style="{StaticResource SecondaryCaptionTextStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!--
                            .activity-grid: one column when narrow, 2 x 2 in the wide state. Gaps come
                            from per group margins so the unused rows stay collapsed when wide.
                        -->
                        <Grid x:Name="ActivityGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel
                                x:Name="PreferenceGroup"
                                Grid.ColumnSpan="2"
                                Spacing="8">
                                <TextBlock x:Name="PreferenceTitleText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Name="LikeButton"
                                        Click="LikeButton_Click"
                                        Style="{StaticResource SubtleControlButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon
                                                x:Name="LikeGlyph"
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Glyph="&#xEB51;" />
                                            <TextBlock x:Name="LikeText" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="ExcludeButton"
                                        Click="ExcludeButton_Click"
                                        Style="{StaticResource SubtleControlButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Glyph="&#xE711;" />
                                            <TextBlock x:Name="ExcludeText" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="ClearPreferenceButton"
                                        Click="ClearPreferenceButton_Click"
                                        Style="{StaticResource TextActionButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel
                                x:Name="WatchlistGroup"
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Margin="0,24,0,0"
                                Spacing="8">
                                <TextBlock x:Name="WatchlistTitleText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Button
                                    x:Name="WatchlistButton"
                                    Click="WatchlistButton_Click"
                                    Style="{StaticResource SubtleControlButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon
                                            x:Name="WatchlistGlyph"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Glyph="&#xE734;" />
                                        <TextBlock x:Name="WatchlistText" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel
                                x:Name="WatchingGroup"
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Margin="0,24,0,0"
                                Spacing="8">
                                <TextBlock x:Name="WatchingTitleText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Button
                                    x:Name="MarkWatchedButton"
                                    Click="MarkWatchedButton_Click"
                                    Style="{StaticResource SubtleControlButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Glyph="&#xE7B3;" />
                                        <TextBlock x:Name="MarkWatchedText" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel
                                x:Name="WatchedDateGroup"
                                Grid.Row="3"
                                Grid.ColumnSpan="2"
                                Margin="0,24,0,0"
                                Spacing="8">
                                <TextBlock x:Name="WatchedDateLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <CalendarDatePicker
                                        x:Name="WatchedDatePicker"
                                        MinWidth="220"
                                        Height="{StaticResource ControlRowHeight}"
                                        DateChanged="WatchedDatePicker_DateChanged" />
                                    <Button
                                        x:Name="MarkOnDateButton"
                                        VerticalAlignment="Center"
                                        Click="MarkOnDateButton_Click"
                                        IsEnabled="False"
                                        Style="{StaticResource SubtleControlButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <!--  .activity-history-section: full width under the group grid.  -->
                        <Border
                            BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="0,16,0,0">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="HistoryTitleText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    x:Name="NoHistoryText"
                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                    TextWrapping="Wrap" />
                                <ItemsRepeater x:Name="HistoryRepeater">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:WatchHistoryDisplayRecord">
                                            <Border
                                                BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}"
                                                BorderThickness="0,0,0,1">
                                                <Grid MinHeight="40" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="32" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource BodyTextBlockStyle}"
                                                        Text="{x:Bind Date}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                                        Text="{x:Bind Label}" />
                                                    <Button
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="{x:Bind RemoveLabel}"
                                                        Click="RemoveHistoryButton_Click"
                                                        Style="{StaticResource SubtleIconActionButtonStyle}"
                                                        Tag="{x:Bind}"
                                                        ToolTipService.ToolTip="{x:Bind RemoveLabel}">
                                                        <FontIcon FontSize="13" Glyph="&#xE74D;" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
