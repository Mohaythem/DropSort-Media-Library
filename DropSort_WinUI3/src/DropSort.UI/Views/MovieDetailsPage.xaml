<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="DropSort.UI.Views.MovieDetailsPage" Background="{ThemeResource FigmaSurfaceAppBrush}" xmlns:models="using:DropSort.UI.Models">
    <Page.Resources>
        <ResourceDictionary>
            <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}" x:Key="DetailsBodyStyle">
                <Setter Property="Foreground" Value="{ThemeResource FigmaTextSecondaryBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="LineHeight" Value="21" />
                <Setter Property="LineStackingStrategy" Value="MaxHeight" />
            </Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource DetailsBodyStyle}" x:Key="DetailsSmallStyle">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="LineHeight" Value="19" />
            </Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource DetailsSmallStyle}" x:Key="DetailsCaptionStyle">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="LineHeight" Value="18" />
            </Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}" x:Key="DetailsTitleStyle">
                <Setter Property="Foreground" Value="{ThemeResource FigmaTextPrimaryBrush}" />
                <Setter Property="FontSize" Value="32" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="LineHeight" Value="40" />
                <Setter Property="LineStackingStrategy" Value="MaxHeight" />
            </Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}" x:Key="DetailsHeadingStyle">
                <Setter Property="Foreground" Value="{ThemeResource FigmaTextPrimaryBrush}" />
                <Setter Property="FontSize" Value="21" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource DetailsBodyStyle}" x:Key="DetailsOverviewStyle">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="LineHeight" Value="24" />
            </Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource DetailsSmallStyle}" x:Key="DetailsStatusStyle">
                <Setter Property="Foreground" Value="{ThemeResource FigmaStatusAvailableBrush}" />
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource SubtleControlButtonStyle}" x:Key="DetailsButtonStyle">
                <Setter Property="Background" Value="{ThemeResource FigmaSurfaceControlBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource FigmaBorderDefaultBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource FigmaTextPrimaryBrush}" />
                <Setter Property="Padding" Value="14,4,14,4" />
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource DetailsButtonStyle}" x:Key="DetailsAccentButtonStyle">
                <Setter Property="Background" Value="{ThemeResource FigmaAccentButtonBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource FigmaAccentForegroundBrush}" />
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource DetailsButtonStyle}" x:Key="DetailsSelectedButtonStyle">
                <Setter Property="Background" Value="{ThemeResource FigmaAccentSelectedSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource FigmaAccentButtonBrush}" />
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource TextActionButtonStyle}" x:Key="DetailsLinkStyle">
                <Setter Property="Foreground" Value="{ThemeResource FigmaAccentButtonBrush}" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource DetailsButtonStyle}" x:Key="DetailsIconButtonStyle">
                <Setter Property="Padding" Value="4" />
                <Setter Property="MinWidth" Value="24" />
                <Setter Property="MinHeight" Value="24" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>
    <ScrollViewer x:Name="Root" Style="{StaticResource PageScrollViewerStyle}" Padding="40,8,40,48" Background="{ThemeResource FigmaSurfaceAppBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="DetailsWidthStates">
                <VisualState x:Name="DetailsWideState">
                    <VisualState.Setters>
                        <Setter Target="GalleryPanel.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="ReadingPane.(Grid.Row)" Value="0" />
                        <Setter Target="ReadingPane.(Grid.Column)" Value="1" />
                        <Setter Target="ReadingPane.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="PreferenceActionsPanel.Orientation" Value="Horizontal" />
                        <Setter Target="FileActionsPanel.Orientation" Value="Horizontal" />
                        <Setter Target="HeroPosterColumn.Width" Value="420" />
                        <Setter Target="PosterSurface.Width" Value="420" />
                        <Setter Target="WatchPane.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="FilesPane.(Grid.Row)" Value="0" />
                        <Setter Target="FilesPane.(Grid.Column)" Value="1" />
                        <Setter Target="FilesPane.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="WatchedDateGroup.(Grid.Row)" Value="0" />
                        <Setter Target="WatchedDateGroup.(Grid.Column)" Value="2" />
                        <Setter Target="WatchedDateGroup.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="WatchedDateGroup.HorizontalAlignment" Value="Right" />
                        <Setter Target="WatchedDateControlsPanel.Orientation" Value="Horizontal" />
                        <Setter Target="PosterSurface.Height" Value="630" />
                        <Setter Target="PlayButton.(Grid.Row)" Value="0" />
                        <Setter Target="AddToListButton.(Grid.Row)" Value="0" />
                        <Setter Target="MatchButton.(Grid.Row)" Value="0" />
                        <Setter Target="MoreButton.(Grid.Row)" Value="0" />
                        <Setter Target="PlayButton.(Grid.Column)" Value="0" />
                        <Setter Target="AddToListButton.(Grid.Column)" Value="1" />
                        <Setter Target="MatchButton.(Grid.Column)" Value="2" />
                        <Setter Target="MoreButton.(Grid.Column)" Value="3" />
                        <Setter Target="PreferenceGroup.Orientation" Value="Horizontal" />
                        <Setter Target="DailyCommandsGrid.RowSpacing" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="DetailsMediumState">
                    <VisualState.Setters>
                        <Setter Target="WatchedDateControlsPanel.Orientation" Value="Horizontal" />
                        <Setter Target="GalleryPanel.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="ReadingPane.(Grid.Row)" Value="0" />
                        <Setter Target="ReadingPane.(Grid.Column)" Value="1" />
                        <Setter Target="ReadingPane.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="PreferenceActionsPanel.Orientation" Value="Horizontal" />
                        <Setter Target="HeroPosterColumn.Width" Value="300" />
                        <Setter Target="PosterSurface.Width" Value="300" />
                        <Setter Target="PosterSurface.Height" Value="450" />
                        <Setter Target="AddToListButton.(Grid.Row)" Value="0" />
                        <Setter Target="AddToListButton.(Grid.Column)" Value="1" />
                        <Setter Target="MatchButton.(Grid.Row)" Value="1" />
                        <Setter Target="MatchButton.(Grid.Column)" Value="0" />
                        <Setter Target="MoreButton.(Grid.Row)" Value="1" />
                        <Setter Target="MoreButton.(Grid.Column)" Value="1" />
                        <Setter Target="FileActionsPanel.Orientation" Value="Vertical" />
                        <Setter Target="PreferenceGroup.Orientation" Value="Horizontal" />
                        <Setter Target="DailyCommandsGrid.RowSpacing" Value="0" />
                        <Setter Target="PlayButton.Margin" Value="0,0,0,10" />
                        <Setter Target="AddToListButton.Margin" Value="0,0,0,10" />
                        <Setter Target="MatchButton.Margin" Value="0,0,0,10" />
                        <Setter Target="MoreButton.Margin" Value="0,0,0,10" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="DetailsCompactState">
                    <VisualState.Setters>
                        <Setter Target="HeroPosterColumn.Width" Value="*" />
                        <Setter Target="HeroGrid.ColumnSpacing" Value="0" />
                        <Setter Target="GalleryPanel.MaxWidth" Value="220" />
                        <Setter Target="PosterSurface.Width" Value="220" />
                        <Setter Target="PosterSurface.Height" Value="330" />
                        <Setter Target="PreferenceActionsPanel.Orientation" Value="Vertical" />
                        <Setter Target="WatchedDateControlsPanel.Orientation" Value="Vertical" />
                        <Setter Target="Root.Padding" Value="24,24,24,48" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel Spacing="24" x:Name="PageContent">
            <Grid Height="48">
                <Button x:Name="BackButton" Click="BackButton_Click" Style="{StaticResource DetailsButtonStyle}" Padding="12,8" MinHeight="40" HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE72B;" FontSize="16" Width="16" Height="16" VerticalAlignment="Center" MirroredWhenRightToLeft="True" />
                        <TextBlock x:Name="BackText" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
            <Grid ColumnSpacing="40" RowSpacing="32" x:Name="HeroGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" x:Name="HeroPosterColumn" />
                    <ColumnDefinition Width="*" x:Name="HeroCopyColumn" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Background="{ThemeResource FigmaSurfaceSecondaryBrush}" Padding="0" CornerRadius="8" VerticalAlignment="Top" HorizontalAlignment="Left" x:Name="GalleryPanel" Grid.ColumnSpan="2">
                    <Border x:Name="PosterSurface" Width="420" Height="630" Padding="0" CornerRadius="8" Style="{StaticResource PosterSurfaceStyle}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid>
                            <Image x:Name="PosterImage" Stretch="Uniform" />
                            <FontIcon x:Name="PosterGlyph" FontSize="40" Foreground="{ThemeResource PosterGlyphForegroundBrush}" Glyph="&#xE714;" />
                        </Grid>
                    </Border>
                </Border>
                <StackPanel Spacing="32" x:Name="ReadingPane" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2">
                    <StackPanel Spacing="24" x:Name="HeroCopyPanel">
                        <TextBlock x:Name="KindText" Style="{StaticResource DetailsCaptionStyle}" />
                        <Grid x:Name="MovieTitleContainer" VerticalAlignment="Center">
                            <StackPanel x:Name="MovieTitleViewPanel" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock x:Name="MovieTitleText"
                                           Style="{StaticResource DetailsTitleStyle}"
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="False"
                                           PointerPressed="MovieTitleText_PointerPressed"
                                           DoubleTapped="MovieTitleText_DoubleTapped"
                                           KeyDown="MovieTitleText_KeyDown"
                                           IsTabStop="True" />
                                <Border x:Name="MovieTitleCopiedBadge"
                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="MovieTitleCopiedText"
                                               Text="Copied!"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBox x:Name="MovieTitleEditBox"
                                     FontSize="28"
                                     FontWeight="SemiBold"
                                     MaxLength="500"
                                     Visibility="Collapsed"
                                     VerticalAlignment="Center"
                                     KeyDown="MovieTitleEditBox_KeyDown"
                                     LostFocus="MovieTitleEditBox_LostFocus" />
                        </Grid>
                        <Grid ColumnSpacing="16" x:Name="MovieIdentityGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="MovieMetaText" Style="{StaticResource DetailsBodyStyle}" TextWrapping="Wrap" />
                            <Border x:Name="RatingPanel"
                                    Grid.Column="1"
                                    Style="{StaticResource StatusPillStyle}"
                                    Background="{ThemeResource LayerFillColorAltBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                <StackPanel Spacing="6" Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Tag="DetailsIcon:star" Width="16" Height="16">
                                    <Image Width="16" Height="16">
                                        <Image.Source>
                                            <SvgImageSource UriSource="ms-appx:///Assets/MovieDetails/star.svg" />
                                        </Image.Source>
                                    </Image>
                                    <FontIcon Glyph="" FontSize="16" Foreground="{ThemeResource FigmaTextPrimaryBrush}" Visibility="Collapsed" />
                                </Grid>
                                <TextBlock Style="{StaticResource DetailsBodyStyle}" x:Name="RatingText" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="GenresText" Style="{StaticResource DetailsBodyStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
                        <TextBlock x:Name="OriginalTitleText" Style="{StaticResource DetailsSmallStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
                        <Border x:Name="OverviewSection" BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}" BorderThickness="0" Padding="0">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="OverviewTitleText" Style="{StaticResource BodyStrongTextBlockStyle}" Visibility="Collapsed" />
                                <TextBlock x:Name="OverviewText" MaxLines="5" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" Style="{StaticResource DetailsOverviewStyle}" TextWrapping="Wrap" />
                                <Button x:Name="OverviewToggleButton" Click="OverviewToggleButton_Click" Style="{StaticResource DetailsLinkStyle}" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <Grid ColumnSpacing="8" RowSpacing="8" x:Name="DailyCommandsGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button x:Name="PlayButton" Click="PlayButton_Click" Style="{StaticResource DetailsAccentButtonStyle}" MinHeight="40" Grid.Row="0" Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Grid Tag="DetailsIcon:play" Width="18" Height="18">
                                        <Image Width="18" Height="18">
                                            <Image.Source>
                                                <SvgImageSource UriSource="ms-appx:///Assets/MovieDetails/play.svg" />
                                            </Image.Source>
                                        </Image>
                                        <FontIcon Glyph="" FontSize="18" Foreground="{ThemeResource FigmaTextPrimaryBrush}" Visibility="Collapsed" />
                                    </Grid>
                                    <TextBlock x:Name="PlayText" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <DropDownButton x:Name="AddToListButton" Style="{StaticResource DetailsButtonStyle}" MinHeight="40" Grid.Row="1" Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Grid Tag="DetailsIcon:list" Width="18" Height="18">
                                        <Image Width="18" Height="18">
                                            <Image.Source>
                                                <SvgImageSource UriSource="ms-appx:///Assets/MovieDetails/list.svg" />
                                            </Image.Source>
                                        </Image>
                                        <FontIcon Glyph="" FontSize="18" Foreground="{ThemeResource FigmaTextPrimaryBrush}" Visibility="Collapsed" />
                                    </Grid>
                                    <TextBlock x:Name="AddToListText" VerticalAlignment="Center" />
                                </StackPanel>
                                <DropDownButton.Flyout>
                                    <MenuFlyout x:Name="AddToListFlyout" Opening="AddToListFlyout_Opening" Placement="BottomEdgeAlignedLeft" />
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <DropDownButton x:Name="MatchButton" Style="{StaticResource DetailsButtonStyle}" MinHeight="40" Grid.Row="2" Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon x:Name="MatchGlyph" VerticalAlignment="Center" FontSize="14" Glyph="&#xE72C;" />
                                    <ProgressRing x:Name="MatchProgress" Width="14" Height="14" VerticalAlignment="Center" IsActive="False" Visibility="Collapsed" />
                                    <TextBlock x:Name="MatchText" VerticalAlignment="Center" />
                                </StackPanel>
                                <DropDownButton.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuFlyoutItem x:Name="RefreshMetadataMenuItem" Click="RefreshMetadataMenuItem_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE72C;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="ChangeMatchButton" Click="ChangeMatchButton_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE721;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <Button x:Name="MoreButton" VerticalAlignment="Top" Style="{StaticResource DetailsButtonStyle}" MinHeight="40" Grid.Row="3" Grid.Column="0">
                                <FontIcon Glyph="&#xE712;" FontSize="18" />
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <StackPanel Width="{StaticResource FileDetailsFlyoutWidth}" Spacing="8">
                                            <Button x:Name="MoveToSeriesButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="MoveToSeriesButton_Click" Style="{StaticResource TextActionButtonStyle}" />
                                            <Button x:Name="RemoveFromLibraryButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="RemoveFromLibraryButton_Click" Style="{StaticResource TextActionButtonStyle}" />
                                            <TextBlock x:Name="DateAddedText" Style="{StaticResource DetailsSmallStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                        <StackPanel x:Name="PreferenceGroup" Spacing="12">
                            <StackPanel x:Name="PreferenceActionsPanel" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="FavoriteButton" Click="FavoriteButton_Click" Style="{StaticResource DetailsButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Grid Tag="DetailsIcon:heart" Width="18" Height="18">
                                            <Image Width="18" Height="18">
                                                <Image.Source>
                                                    <SvgImageSource UriSource="ms-appx:///Assets/MovieDetails/heart.svg" />
                                                </Image.Source>
                                            </Image>
                                            <FontIcon x:Name="FavoriteGlyph" VerticalAlignment="Center" FontSize="14" Glyph="" Visibility="Collapsed" />
                                        </Grid>
                                        <TextBlock x:Name="FavoriteText" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="WatchlistButton" Click="WatchlistButton_Click" Style="{StaticResource DetailsButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Grid Tag="DetailsIcon:bookmark" Width="18" Height="18">
                                            <Image Width="18" Height="18">
                                                <Image.Source>
                                                    <SvgImageSource UriSource="ms-appx:///Assets/MovieDetails/bookmark.svg" />
                                                </Image.Source>
                                            </Image>
                                            <FontIcon x:Name="WatchlistGlyph" VerticalAlignment="Center" FontSize="14" Glyph="" Visibility="Collapsed" />
                                        </Grid>
                                        <TextBlock x:Name="WatchlistText" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <Border BorderBrush="{ThemeResource FigmaBorderDefaultBrush}" BorderThickness="0,1,0,0" Padding="0" />
                    <Grid ColumnSpacing="40" RowSpacing="32" x:Name="RecordsGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" x:Name="WatchColumn" />
                            <ColumnDefinition Width="2*" x:Name="FilesColumn" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="12" x:Name="WatchPane" Grid.ColumnSpan="2">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ActivityTitleText" Style="{StaticResource DetailsHeadingStyle}" />
                                <TextBlock x:Name="WatchingTitleText" Style="{StaticResource DetailsStatusStyle}" Visibility="Visible" Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock x:Name="ActivityHelpText" Style="{StaticResource DetailsSmallStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
                            <Grid ColumnSpacing="12" RowSpacing="12" x:Name="WatchControlsGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel x:Name="WatchingGroup" Spacing="0">
                                    <Button x:Name="MarkWatchedButton" Click="MarkWatchedButton_Click" Style="{StaticResource DetailsButtonStyle}" MinHeight="40">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Grid Tag="DetailsIcon:check" Width="18" Height="18">
                                                <Image Width="18" Height="18">
                                                    <Image.Source>
                                                        <SvgImageSource UriSource="ms-appx:///Assets/MovieDetails/check.svg" />
                                                    </Image.Source>
                                                </Image>
                                                <FontIcon VerticalAlignment="Center" FontSize="14" Glyph="" Visibility="Collapsed" />
                                            </Grid>
                                            <TextBlock x:Name="MarkWatchedText" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel x:Name="WatchedDateGroup" Spacing="8" Grid.Row="1" Grid.ColumnSpan="3" HorizontalAlignment="Left">
                                    <TextBlock x:Name="WatchedDateLabel" Style="{StaticResource BodyStrongTextBlockStyle}" Visibility="Collapsed" />
                                    <StackPanel x:Name="WatchedDateControlsPanel" Orientation="Vertical" Spacing="8">
                                        <CalendarDatePicker x:Name="WatchedDatePicker" Height="40" MinWidth="0" DateChanged="WatchedDatePicker_DateChanged" Width="150" />
                                        <Button x:Name="MarkOnDateButton" VerticalAlignment="Center" Click="MarkOnDateButton_Click" IsEnabled="False" Style="{StaticResource DetailsButtonStyle}" MinHeight="40" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <Border BorderBrush="{ThemeResource FigmaBorderDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="HistoryTitleText" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource FigmaTextSecondaryBrush}" />
                                    <TextBlock x:Name="NoHistoryText" Style="{StaticResource SecondaryCaptionTextStyle}" TextWrapping="Wrap" Foreground="{ThemeResource FigmaTextSecondaryBrush}" />
                                    <ScrollViewer x:Name="HistoryScrollViewer" MaxHeight="132" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" IsTabStop="True" Padding="0,0,12,0" AutomationProperties.LabeledBy="{Binding ElementName=HistoryTitleText}">
                                    <ItemsRepeater x:Name="HistoryRepeater">
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="models:WatchHistoryDisplayRecord">
                                                <Border BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}" BorderThickness="0,0,0,1">
                                                    <Grid MinHeight="32" ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="32" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Date}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource FigmaTextSecondaryBrush}" />
                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind Label}" Foreground="{ThemeResource FigmaTextSecondaryBrush}" />
                                                        <Button Grid.Column="2" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind RemoveLabel}" Click="RemoveHistoryButton_Click" Style="{StaticResource SubtleIconActionButtonStyle}" Tag="{x:Bind}" ToolTipService.ToolTip="{x:Bind RemoveLabel}">
                                                            <FontIcon FontSize="13" Glyph="" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Spacing="12" x:Name="FilesPane" Grid.Row="1" Grid.ColumnSpan="2">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="FileDetailsTitleText" VerticalAlignment="Center" Style="{StaticResource DetailsHeadingStyle}" />
                                <Border x:Name="PresentPill" Grid.Column="1" Background="Transparent" BorderThickness="0">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="" />
                                        <TextBlock x:Name="PresentText" VerticalAlignment="Center" Style="{StaticResource DetailsStatusStyle}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <StackPanel x:Name="FilePresentPanel" Spacing="4">
                                <TextBlock x:Name="FileNameText" Style="{StaticResource DetailsBodyStyle}" TextWrapping="Wrap" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="FilePathText" FlowDirection="LeftToRight" IsTextSelectionEnabled="True" Style="{StaticResource DetailsSmallStyle}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
                                    <StackPanel Spacing="8" x:Name="PathActionsPanel" Orientation="Horizontal" Grid.Column="1">
                                        <Button Click="CopyPathButton_Click" Style="{StaticResource DetailsIconButtonStyle}" x:Name="CopyPathButton">
                                            <Grid Tag="DetailsIcon:copy" Width="16" Height="16">
                                                <Image Width="16" Height="16">
                                                    <Image.Source>
                                                        <SvgImageSource UriSource="ms-appx:///Assets/MovieDetails/copy.svg" />
                                                    </Image.Source>
                                                </Image>
                                                <FontIcon Glyph="" FontSize="16" Foreground="{ThemeResource FigmaTextPrimaryBrush}" Visibility="Collapsed" />
                                            </Grid>
                                        </Button>
                                        <Button Click="ExpandPathButton_Click" Style="{StaticResource DetailsIconButtonStyle}" x:Name="ExpandPathButton">
                                            <Grid Tag="DetailsIcon:collapse" Width="16" Height="16">
                                                <Image Width="16" Height="16">
                                                    <Image.Source>
                                                        <SvgImageSource UriSource="ms-appx:///Assets/MovieDetails/collapse.svg" />
                                                    </Image.Source>
                                                </Image>
                                                <FontIcon Glyph="" FontSize="16" Foreground="{ThemeResource FigmaTextPrimaryBrush}" Visibility="Collapsed" />
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="FileFactsText" Style="{StaticResource DetailsSmallStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="AllFilesPanel" Spacing="6" Visibility="Collapsed">
                                <TextBlock x:Name="AllFilesHeadingText" Style="{StaticResource TertiaryCaptionTextStyle}" />
                                <ItemsRepeater x:Name="MediaFilesRepeater">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="8" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:MovieFileRecord">
                                            <Border BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}" BorderThickness="0,0,0,1" Padding="0,8,0,8">
                                                <StackPanel Spacing="2">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind FileName}" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource TertiaryCaptionTextStyle}" Text="{x:Bind Availability}" />
                                                    </Grid>
                                                    <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource SecondaryCaptionTextStyle}" FlowDirection="LeftToRight" Text="{x:Bind FilePath}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind Facts}" Style="{StaticResource TertiaryCaptionTextStyle}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                            <StackPanel x:Name="NoFilePanel" Spacing="4" Visibility="Collapsed">
                                <TextBlock x:Name="NoFileText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="NoFileHelpText" Style="{StaticResource SecondaryCaptionTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="8" x:Name="FileActionsPanel" Orientation="Vertical">
                                <Button x:Name="OpenFolderButton" Click="OpenFolderButton_Click" Style="{StaticResource DetailsButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Grid Tag="DetailsIcon:folder" Width="18" Height="18">
                                            <Image Width="18" Height="18">
                                                <Image.Source>
                                                    <SvgImageSource UriSource="ms-appx:///Assets/MovieDetails/folder.svg" />
                                                </Image.Source>
                                            </Image>
                                            <FontIcon VerticalAlignment="Center" FontSize="14" Glyph="" Visibility="Collapsed" />
                                        </Grid>
                                        <TextBlock x:Name="OpenFolderText" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="OrganizeButton" Click="OrganizeButton_Click" Style="{StaticResource DetailsButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon x:Name="OrganizeGlyph" VerticalAlignment="Center" FontSize="14" Glyph="" />
                                        <ProgressRing x:Name="OrganizeProgress" Width="14" Height="14" VerticalAlignment="Center" IsActive="False" Visibility="Collapsed" />
                                        <TextBlock x:Name="OrganizeText" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="MoveMovieButton" Click="MoveMovieButton_Click" Style="{StaticResource DetailsButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon x:Name="MoveMovieGlyph" VerticalAlignment="Center" FontSize="14" Glyph="" />
                                        <ProgressRing x:Name="MoveMovieProgress" Width="14" Height="14" VerticalAlignment="Center" IsActive="False" Visibility="Collapsed" />
                                        <TextBlock x:Name="MoveMovieText" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Border BorderBrush="{ThemeResource FigmaBorderDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" x:Name="MetadataFooter">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Name="MetadataStatusText" Style="{StaticResource DetailsStatusStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="MatchedIdentityText" Style="{StaticResource DetailsSmallStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
