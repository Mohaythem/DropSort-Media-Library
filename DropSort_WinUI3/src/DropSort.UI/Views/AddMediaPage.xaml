<Page
    x:Class="DropSort.UI.Views.AddMediaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DropSort.UI.Controls"
    xmlns:models="using:DropSort.UI.Models"
    Background="Transparent">

    <Page.Resources>
        <!--
            A column header that reads as part of the table header row, not a separate filled button:
            transparent in every state (so it shows the header-row background), no fill on hover/press,
            and only a subtle heavier stroke outlines the cell on hover/active. The content fills the
            whole cell so the entire column header is clickable; the header lays out its own text (left)
            and sort arrow (far right).
        -->
        <Style x:Key="TableHeaderSortButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,0,4,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
            <DataTemplate x:Key="FileReviewTemplate" x:DataType="models:DetectedMediaDisplayRecord">
                            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,10" Margin="{x:Bind ReviewIndent, Mode=OneWay}">
                                <Grid ColumnSpacing="12" RowSpacing="6" MinHeight="64" SizeChanged="ReviewRow_SizeChanged">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <CheckBox VerticalAlignment="Top" AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind IsSelectionEnabled, Mode=OneWay}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{x:Bind IdentityLabel, Mode=OneWay}" Style="{StaticResource SecondaryCaptionTextStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{x:Bind FileName, Mode=OneWay}" Style="{StaticResource TertiaryCaptionTextStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{x:Bind EvidenceLabel, Mode=OneWay}" Style="{StaticResource SecondaryCaptionTextStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind ComparisonLabel, Mode=OneWay}" Visibility="{x:Bind ComparisonVisibility, Mode=OneWay}" Style="{StaticResource SecondaryCaptionTextStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                    <StackPanel x:Name="RowState" Grid.Column="2" Spacing="2">
                                        <TextBlock Text="{x:Bind LocalEligibilityLabel, Mode=OneWay}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind StatusLabel, Mode=OneWay}" Style="{StaticResource SecondaryCaptionTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel x:Name="RowActions" Grid.Column="3" Spacing="4" HorizontalAlignment="Left">
                                        <Button Content="{x:Bind CorrectionLabel, Mode=OneWay}" Tag="{x:Bind}" Click="CorrectTv_Click" Visibility="{x:Bind CorrectionVisibility, Mode=OneWay}" Style="{StaticResource TextActionButtonStyle}" />
                                        <Button Content="{x:Bind ManualMatchLabel, Mode=OneWay}" Tag="{x:Bind}" Click="ManualMatch_Click" Visibility="{x:Bind ManualMatchVisibility, Mode=OneWay}" Style="{StaticResource TextActionButtonStyle}" />
                                        <Button Content="{x:Bind RetryLabel, Mode=OneWay}" Tag="{x:Bind}" Click="RetryMetadata_Click" Visibility="{x:Bind RetryVisibility, Mode=OneWay}" Style="{StaticResource TextActionButtonStyle}" />
                                        <Button Content="{x:Bind DetailsLabel, Mode=OneWay}" Tag="{x:Bind}" Click="RowDetails_Click" Style="{StaticResource TextActionButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>

        <DataTemplate x:Key="TvGroupTemplate" x:DataType="models:TvReviewGroupHeader">
            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                <Grid ColumnSpacing="12" MinHeight="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox MinWidth="0" Width="32" HorizontalAlignment="Left" VerticalAlignment="Center" IsThreeState="True" IsChecked="{x:Bind Selected, Mode=OneWay}" IsEnabled="{x:Bind CanSelect, Mode=OneWay}" AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}" Tag="{x:Bind}" Click="GroupSelection_Click" />
                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Label, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Count, Mode=OneWay}" Style="{StaticResource SecondaryCaptionTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Width="32" Height="32" Padding="0" VerticalAlignment="Center" Tag="{x:Bind}" Click="GroupExpand_Click" IsEnabled="{x:Bind IsEnabled, Mode=OneWay}" AutomationProperties.Name="{x:Bind ExpandLabel, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ExpandLabel, Mode=OneWay}" Style="{StaticResource TextActionButtonStyle}">
                        <FontIcon Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="12" />
                    </Button>
                    <Button Grid.Column="3" Content="{x:Bind CorrectLabel, Mode=OneWay}" Tag="{x:Bind}" Click="CorrectTv_Click" IsEnabled="{x:Bind IsEnabled, Mode=OneWay}" VerticalAlignment="Center" Style="{StaticResource TextActionButtonStyle}" />
                </Grid>
            </Border>
        </DataTemplate>
        <models:AddMediaTemplateSelector x:Key="ReviewTemplateSelector" FileTemplate="{StaticResource FileReviewTemplate}" GroupTemplate="{StaticResource TvGroupTemplate}" />
    </Page.Resources>

    <!-- This ListView owns one bounded viewport, including the source/toolbar header and existing-file footer. -->
    <ListView x:Name="Root" ItemTemplateSelector="{StaticResource ReviewTemplateSelector}" Background="Transparent" SizeChanged="PageRoot_SizeChanged" ContainerContentChanging="ReviewContainer_ContentChanging"
              SelectionMode="None" HorizontalContentAlignment="Stretch"
              ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="MaxWidth" Value="{StaticResource AddMediaContentMaxWidth}" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
            </Style>
        </ListView.ItemContainerStyle>
        <ListView.Header>
        <StackPanel x:Name="ContentHost" HorizontalAlignment="Left" Spacing="20">
            <StackPanel Spacing="4">
                <TextBlock x:Name="PageTitleText" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="SourceHelpText" Style="{StaticResource SecondaryBodyTextStyle}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock x:Name="FolderLabelText" Style="{StaticResource SecondaryCaptionTextStyle}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderPathBox" Style="{StaticResource FormInputTextBoxStyle}" />
                    <Button x:Name="BrowseButton" Grid.Column="1" Click="BrowseButton_Click" Style="{StaticResource SubtleControlButtonStyle}" />
                </Grid>
                <StackPanel x:Name="SourceActions" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ScanButton" Click="ScanButton_Click" Style="{StaticResource AccentControlButtonStyle}" />
                    <Button x:Name="AddFilesButton" Click="AddFilesButton_Click" Style="{StaticResource SubtleControlButtonStyle}" />
                    <Button x:Name="CancelButton" Click="CancelButton_Click" Style="{StaticResource SubtleControlButtonStyle}" Visibility="Collapsed" />
                </StackPanel>
                <CheckBox x:Name="LocalOnlyBox" Checked="LocalOnlyBox_Changed" Unchecked="LocalOnlyBox_Changed" />
                <StackPanel x:Name="ScanProgressPanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Name="ScanProgressText" Style="{StaticResource SecondaryCaptionTextStyle}" TextWrapping="Wrap" />
                    <ProgressBar x:Name="ScanProgressBar" Height="4" />
                </StackPanel>
            </StackPanel>
            <controls:EmptyStateCard x:Name="EmptyState" Glyph="&#xE8B7;" Visibility="Collapsed" />
            <StackPanel x:Name="ResultsSection" Spacing="12" Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="ResultsHeadingText" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="ResultsCountText" Style="{StaticResource SecondaryBodyTextStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="SummaryText" Style="{StaticResource SecondaryCaptionTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
                <Grid x:Name="ReviewToolbar" ColumnSpacing="12" RowSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel x:Name="PrimaryActions" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AddSelectedButton" Click="AddSelectedButton_Click" Style="{StaticResource AccentControlButtonStyle}" />
                    <Button x:Name="SelectReadyButton" Click="SelectReadyButton_Click" Style="{StaticResource SubtleControlButtonStyle}" />
                </StackPanel>
<StackPanel x:Name="SelectionActions" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SelectAllButton" Click="SelectAllButton_Click" Style="{StaticResource TextActionButtonStyle}" />
                    <Button x:Name="DeselectAllButton" Click="DeselectAllButton_Click" Style="{StaticResource TextActionButtonStyle}" />
                </StackPanel>
<ComboBox x:Name="ReviewFilterBox" Grid.Row="1" SelectionChanged="ReviewFilter_SelectionChanged" HorizontalAlignment="Left" MinWidth="180">
                    <ComboBoxItem x:Name="AllNewFilterItem" />
                    <ComboBoxItem x:Name="ReadyFilterItem" />
                    <ComboBoxItem x:Name="AttentionFilterItem" />
                </ComboBox>
<TextBlock x:Name="SelectionFeedbackText" Grid.Column="1" Grid.Row="1" VerticalAlignment="Center" Style="{StaticResource SecondaryCaptionTextStyle}" TextWrapping="Wrap" />
                </Grid>
                <InfoBar x:Name="SeriesSuggestionBar" IsClosable="True" IsOpen="False" Severity="Informational" Visibility="Collapsed">
                    <InfoBar.ActionButton><Button x:Name="TreatAllAsTvButton" Click="TreatAllAsTv_Click" /></InfoBar.ActionButton>
                </InfoBar>
                <Grid x:Name="TableHeader" Padding="0,4" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="ColumnSelectText" Style="{StaticResource TertiaryCaptionTextStyle}" />
                    <StackPanel x:Name="SortActions" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button
                                    x:Name="SortTitleButton"
                                    Click="SortTitle_Click"
                                    Style="{StaticResource TableHeaderSortButtonStyle}">
                                    <Grid ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ColumnTitleText" VerticalAlignment="Center" Style="{StaticResource TertiaryCaptionTextStyle}" />
                                        <FontIcon x:Name="SortTitleIndicator" Grid.Column="1" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="10" Visibility="Collapsed" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
<Button
                                    x:Name="SortTypeButton"
                                    Click="SortType_Click"
                                    Style="{StaticResource TableHeaderSortButtonStyle}">
                                    <Grid ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ColumnTypeText" VerticalAlignment="Center" Style="{StaticResource TertiaryCaptionTextStyle}" />
                                        <FontIcon x:Name="SortTypeIndicator" Grid.Column="1" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="10" Visibility="Collapsed" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                    </StackPanel>
                    <Button
                                    x:Name="SortStatusButton" Grid.Column="2" HorizontalAlignment="Left"
                                    Click="SortStatus_Click"
                                    Style="{StaticResource TableHeaderSortButtonStyle}">
                                    <Grid ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ColumnStatusText" VerticalAlignment="Center" Style="{StaticResource TertiaryCaptionTextStyle}" />
                                        <FontIcon x:Name="SortStatusIndicator" Grid.Column="1" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="10" Visibility="Collapsed" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                    <TextBlock x:Name="ColumnActionText" Grid.Column="3" Style="{StaticResource TertiaryCaptionTextStyle}" />
                </Grid>

                <TextBlock x:Name="QueueEmptyText" Style="{StaticResource SecondaryBodyTextStyle}" TextWrapping="Wrap" Visibility="Collapsed" />

            </StackPanel>
        </StackPanel>
        </ListView.Header>

        <ListView.Footer>
                            <Expander x:Name="RegisteredSection" IsExpanded="False" Expanding="RegisteredSection_Expanding" Collapsed="RegisteredSection_Collapsed" Width="{Binding Width, ElementName=ContentHost, Mode=OneWay}" HorizontalAlignment="Left" HorizontalContentAlignment="Stretch" Visibility="Collapsed">
                    <ListView x:Name="RegisteredMediaRepeater" ContainerContentChanging="RegisteredContainer_ContentChanging" MaxHeight="360" SelectionMode="None" HorizontalContentAlignment="Stretch">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:DetectedMediaDisplayRecord">
                                <StackPanel Spacing="4" Padding="0,8">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind IdentityLabel, Mode=OneWay}" Style="{StaticResource SecondaryCaptionTextStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Item.Path}" IsTextSelectionEnabled="True" TextWrapping="Wrap" Style="{StaticResource TertiaryCaptionTextStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Expander>
        </ListView.Footer>
    </ListView>
</Page>
