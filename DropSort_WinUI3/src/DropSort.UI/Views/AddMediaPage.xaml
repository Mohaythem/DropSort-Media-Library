<Page
    x:Class="DropSort.UI.Views.AddMediaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DropSort.UI.Controls"
    xmlns:models="using:DropSort.UI.Models"
    Background="Transparent">

    <Page.Resources>
        <!--
            A column header that reads as part of the table header row, not a separate filled button:
            transparent in every state (so it shows the header-row background), no fill on hover/press,
            and only a subtle heavier stroke outlines the cell on hover/active. The content fills the
            whole cell so the entire column header is clickable; the header lays out its own text (left)
            and sort arrow (far right).
        -->
        <Style x:Key="TableHeaderSortButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,0,4,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="Root" Style="{StaticResource PageScrollViewerStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="{StaticResource AddMediaContentMaxWidth}" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="24">
                <TextBlock x:Name="PageTitleText" Style="{StaticResource TitleTextBlockStyle}" />

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="SourceHeadingText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                x:Name="SourceHelpText"
                                Style="{StaticResource SecondaryBodyTextStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock x:Name="FolderLabelText" Style="{StaticResource SecondaryCaptionTextStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FolderPathBox" Style="{StaticResource FormInputTextBoxStyle}" />
                                <Button
                                    x:Name="BrowseButton"
                                    Grid.Column="1"
                                    Click="BrowseButton_Click"
                                    Style="{StaticResource SubtleControlButtonStyle}" />
                            </Grid>
                        </StackPanel>

                        <Border Style="{StaticResource HairlineDividerStyle}" />

                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="AddFilesButton"
                                Click="AddFilesButton_Click"
                                Style="{StaticResource SubtleControlButtonStyle}" />
                            <Button
                                x:Name="CancelButton"
                                Click="CancelButton_Click"
                                Style="{StaticResource SubtleControlButtonStyle}"
                                Visibility="Collapsed" />
                            <Button
                                x:Name="ScanButton"
                                Click="ScanButton_Click"
                                Style="{StaticResource AccentControlButtonStyle}" />
                        </StackPanel>

                        <StackPanel x:Name="ScanProgressPanel" Spacing="8" Visibility="Collapsed">
                            <TextBlock x:Name="ScanProgressText" Style="{StaticResource SecondaryCaptionTextStyle}" />
                            <ProgressBar x:Name="ScanProgressBar" Height="4" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <controls:EmptyStateCard x:Name="EmptyState" Glyph="&#xE8B7;" Visibility="Collapsed" />

                <StackPanel x:Name="ResultsSection" Spacing="12" Visibility="Collapsed">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="ResultsHeadingText" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Name="ResultsCountText" Style="{StaticResource SecondaryCaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="SelectAllButton"
                                Click="SelectAllButton_Click"
                                Style="{StaticResource SubtleControlButtonStyle}" />
                            <Button
                                x:Name="SelectReadyButton"
                                Click="SelectReadyButton_Click"
                                Style="{StaticResource SubtleControlButtonStyle}" />
                            <Button
                                x:Name="DeselectAllButton"
                                Click="DeselectAllButton_Click"
                                Style="{StaticResource SubtleControlButtonStyle}" />
                            <Button
                                x:Name="AddSelectedButton"
                                Click="AddSelectedButton_Click"
                                Style="{StaticResource AccentControlButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <InfoBar
                        x:Name="SeriesSuggestionBar"
                        IsClosable="True"
                        IsOpen="False"
                        Severity="Informational"
                        Visibility="Collapsed">
                        <InfoBar.ActionButton>
                            <Button x:Name="TreatAllAsTvButton" Click="TreatAllAsTv_Click" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <Border Style="{StaticResource ListSurfaceBorderStyle}">
                        <StackPanel>
                            <Grid Padding="12,0,12,0" ColumnSpacing="12" MinHeight="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ColumnSelectText" VerticalAlignment="Center" Style="{StaticResource TertiaryCaptionTextStyle}" />
                                <Button
                                    x:Name="SortTypeButton"
                                    Grid.Column="1"
                                    Click="SortType_Click"
                                    Style="{StaticResource TableHeaderSortButtonStyle}">
                                    <Grid ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ColumnTypeText" VerticalAlignment="Center" Style="{StaticResource TertiaryCaptionTextStyle}" />
                                        <FontIcon x:Name="SortTypeIndicator" Grid.Column="1" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="10" Visibility="Collapsed" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Button
                                    x:Name="SortTitleButton"
                                    Grid.Column="2"
                                    Click="SortTitle_Click"
                                    Style="{StaticResource TableHeaderSortButtonStyle}">
                                    <Grid ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ColumnTitleText" VerticalAlignment="Center" Style="{StaticResource TertiaryCaptionTextStyle}" />
                                        <FontIcon x:Name="SortTitleIndicator" Grid.Column="1" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="10" Visibility="Collapsed" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <TextBlock x:Name="ColumnPreviewText" Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource TertiaryCaptionTextStyle}" />
                                <TextBlock x:Name="ColumnDetailsText" Grid.Column="4" VerticalAlignment="Center" Style="{StaticResource TertiaryCaptionTextStyle}" />
                                <Button
                                    x:Name="SortStatusButton"
                                    Grid.Column="5"
                                    Click="SortStatus_Click"
                                    Style="{StaticResource TableHeaderSortButtonStyle}">
                                    <Grid ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ColumnStatusText" VerticalAlignment="Center" Style="{StaticResource TertiaryCaptionTextStyle}" />
                                        <FontIcon x:Name="SortStatusIndicator" Grid.Column="1" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="10" Visibility="Collapsed" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <TextBlock x:Name="ColumnActionText" Grid.Column="6" VerticalAlignment="Center" Style="{StaticResource TertiaryCaptionTextStyle}" />
                            </Grid>
                            <Border Style="{StaticResource HairlineDividerStyle}" />
                            <ItemsRepeater x:Name="DetectedMediaRepeater">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:DetectedMediaDisplayRecord">
                                        <Border Style="{StaticResource RowDividerStyle}">
                                            <Grid ColumnSpacing="12" MinHeight="72">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                    IsEnabled="{x:Bind IsSelectionEnabled, Mode=OneWay}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource SecondaryBodyTextStyle}"
                                                    Text="{x:Bind TypeLabel, Mode=OneWay}" />
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock
                                                        Text="{x:Bind Title, Mode=OneWay}"
                                                        IsTextSelectionEnabled="True"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Text="{x:Bind FileName, Mode=OneWay}"
                                                        IsTextSelectionEnabled="True"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2" Visibility="{x:Bind PreviewVisibility, Mode=OneWay}">
                                                    <TextBlock
                                                        Text="{x:Bind PreviewTitle, Mode=OneWay}"
                                                        IsTextSelectionEnabled="True"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Style="{StaticResource TertiaryCaptionTextStyle}"
                                                        Text="{x:Bind PreviewYear, Mode=OneWay}"
                                                        TextTrimming="CharacterEllipsis"
                                                        IsTextSelectionEnabled="True" />
                                                    <TextBlock
                                                        Style="{StaticResource TertiaryCaptionTextStyle}"
                                                        Text="{x:Bind PreviewDetails, Mode=OneWay}"
                                                        TextWrapping="Wrap"
                                                        MaxLines="2"
                                                        IsTextSelectionEnabled="True" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="4"
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind Details, Mode=OneWay}"
                                                    TextWrapping="Wrap"
                                                    IsTextSelectionEnabled="True"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock
                                                    Grid.Column="5"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource SecondaryBodyTextStyle}"
                                                    Text="{x:Bind StatusLabel, Mode=OneWay}" />
                                                <StackPanel Grid.Column="6" VerticalAlignment="Center" Spacing="4">
                                                    <Button
                                                        Content="{x:Bind ManualMatchLabel, Mode=OneWay}"
                                                        Tag="{x:Bind}"
                                                        Click="ManualMatch_Click"
                                                        Visibility="{x:Bind ManualMatchVisibility, Mode=OneWay}"
                                                        AutomationProperties.Name="{x:Bind ManualMatchLabel, Mode=OneWay}"
                                                        Style="{StaticResource TextActionButtonStyle}" />
                                                    <Button
                                                        Content="{x:Bind RetryLabel, Mode=OneWay}"
                                                        Tag="{x:Bind}"
                                                        Click="RetryMetadata_Click"
                                                        Visibility="{x:Bind RetryVisibility, Mode=OneWay}"
                                                        AutomationProperties.Name="{x:Bind RetryLabel, Mode=OneWay}"
                                                        Style="{StaticResource TextActionButtonStyle}" />
                                                    <Button
                                                        Content="{x:Bind OverrideTypeLabel, Mode=OneWay}"
                                                        Tag="{x:Bind}"
                                                        Click="OverrideType_Click"
                                                        Visibility="{x:Bind OverrideTypeVisibility, Mode=OneWay}"
                                                        AutomationProperties.Name="{x:Bind OverrideTypeLabel, Mode=OneWay}"
                                                        Style="{StaticResource TextActionButtonStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
