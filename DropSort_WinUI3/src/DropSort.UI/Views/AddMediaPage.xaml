<Page
    x:Class="DropSort.UI.Views.AddMediaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DropSort.UI.Controls"
    xmlns:models="using:DropSort.UI.Models"
    Background="Transparent">

    <ScrollViewer x:Name="Root" Style="{StaticResource PageScrollViewerStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="{StaticResource AddMediaContentMaxWidth}" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="24">
                <TextBlock x:Name="PageTitleText" Style="{StaticResource TitleTextBlockStyle}" />

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="SourceHeadingText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                x:Name="SourceHelpText"
                                Style="{StaticResource SecondaryBodyTextStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock x:Name="FolderLabelText" Style="{StaticResource SecondaryCaptionTextStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FolderPathBox" Style="{StaticResource FormInputTextBoxStyle}" />
                                <Button
                                    x:Name="BrowseButton"
                                    Grid.Column="1"
                                    Click="BrowseButton_Click"
                                    Style="{StaticResource SubtleControlButtonStyle}" />
                            </Grid>
                        </StackPanel>

                        <Border Style="{StaticResource HairlineDividerStyle}" />

                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="AddFilesButton"
                                Click="AddFilesButton_Click"
                                Style="{StaticResource SubtleControlButtonStyle}" />
                            <Button
                                x:Name="CancelButton"
                                Click="CancelButton_Click"
                                Style="{StaticResource SubtleControlButtonStyle}"
                                Visibility="Collapsed" />
                            <Button
                                x:Name="ScanButton"
                                Click="ScanButton_Click"
                                Style="{StaticResource AccentControlButtonStyle}" />
                        </StackPanel>

                        <StackPanel x:Name="ScanProgressPanel" Spacing="8" Visibility="Collapsed">
                            <TextBlock x:Name="ScanProgressText" Style="{StaticResource SecondaryCaptionTextStyle}" />
                            <ProgressBar x:Name="ScanProgressBar" Height="4" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <controls:EmptyStateCard x:Name="EmptyState" Glyph="&#xE8B7;" Visibility="Collapsed" />

                <StackPanel x:Name="ResultsSection" Spacing="12" Visibility="Collapsed">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="ResultsHeadingText" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Name="ResultsCountText" Style="{StaticResource SecondaryCaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="SelectAllButton"
                                Click="SelectAllButton_Click"
                                Style="{StaticResource SubtleControlButtonStyle}" />
                            <Button
                                x:Name="DeselectAllButton"
                                Click="DeselectAllButton_Click"
                                Style="{StaticResource SubtleControlButtonStyle}" />
                            <Button
                                x:Name="AddSelectedButton"
                                Click="AddSelectedButton_Click"
                                Style="{StaticResource AccentControlButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource ListSurfaceBorderStyle}">
                        <StackPanel>
                            <Grid Padding="12,0,12,0" ColumnSpacing="12" MinHeight="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ColumnSelectText" VerticalAlignment="Center" Style="{StaticResource TertiaryCaptionTextStyle}" />
                                <TextBlock x:Name="ColumnTypeText" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource TertiaryCaptionTextStyle}" />
                                <TextBlock x:Name="ColumnTitleText" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource TertiaryCaptionTextStyle}" />
                                <TextBlock x:Name="ColumnDetailsText" Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource TertiaryCaptionTextStyle}" />
                                <TextBlock x:Name="ColumnStatusText" Grid.Column="4" VerticalAlignment="Center" Style="{StaticResource TertiaryCaptionTextStyle}" />
                            </Grid>
                            <Border Style="{StaticResource HairlineDividerStyle}" />
                            <ItemsRepeater x:Name="DetectedMediaRepeater">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:DetectedMediaDisplayRecord">
                                        <Border Style="{StaticResource RowDividerStyle}">
                                            <Grid ColumnSpacing="12" MinHeight="56">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                    IsEnabled="{x:Bind IsSelectionEnabled, Mode=OneWay}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource SecondaryBodyTextStyle}"
                                                    Text="{x:Bind TypeLabel, Mode=OneWay}" />
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock
                                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                                        Text="{x:Bind Title}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Style="{StaticResource TertiaryCaptionTextStyle}"
                                                        Text="{x:Bind FileName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource SecondaryBodyTextStyle}"
                                                    Text="{x:Bind Details, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="4"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource SecondaryBodyTextStyle}"
                                                    Text="{x:Bind StatusLabel, Mode=OneWay}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>

                    <Border x:Name="SearchTmdbCard" Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="SearchTmdbHeadingText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    x:Name="SearchTmdbHelpText"
                                    Style="{StaticResource SecondaryBodyTextStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <AutoSuggestBox
                                    x:Name="TmdbSearchBox"
                                    QueryIcon="Find"
                                    Style="{StaticResource PageSearchBoxStyle}" />
                                <Button
                                    x:Name="TmdbSearchButton"
                                    Grid.Column="1"
                                    Click="TmdbSearchButton_Click"
                                    Style="{StaticResource SubtleControlButtonStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
