<Page
    x:Class="DropSort.UI.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DropSort.UI.Controls"
    xmlns:models="using:DropSort.UI.Models"
    Background="Transparent">

    <!--
        Padding lives on the ScrollViewer and the content is a single stretched column, so Home fills
        the whole area left of the sidebar: the stat tiles and the Continue watching cards distribute
        across it (UniformGridLayout ItemsStretch="Fill") and the recent grid wraps across it
        (ItemsWrapGrid). There is deliberately no content MaxWidth here - one used to cap the page at
        1040 epx, which is what left the right half of a wide window empty.
    -->
    <ScrollViewer x:Name="Root" Style="{StaticResource PageScrollViewerStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="32">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="PageTitleText" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="PageSubtitleText" Style="{StaticResource SecondaryBodyTextStyle}" />
                </StackPanel>

                <!--
                    No MinItemHeight: UniformGridLayout then takes the measured height of the first
                    tile, so the caption can never be clipped when the type ramp or the user's text
                    scale grows. MaximumRowsOrColumns caps the row at the four stats so they fill
                    the content width instead of leaving a gap where a fifth column would go.
                -->
                <ItemsRepeater x:Name="StatsRepeater">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MaximumRowsOrColumns="4"
                            MinColumnSpacing="12"
                            MinItemWidth="140"
                            MinRowSpacing="12" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:StatCardRecord">
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind Value}" />
                                    <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind Label}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <StackPanel Spacing="12">
                    <TextBlock x:Name="ContinueHeadingText" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <!--
                        MinItemWidth is what decides how roomy a Continue watching card is: the row
                        always fills the content width (ItemsStretch="Fill"), so the only way to give
                        a card more width is to let fewer of them share the row. 340 epx keeps two
                        generous cards on a 1360 epx window - enough that the episode line stops
                        being trimmed - and goes back to three once the window is wide enough to give
                        each of them that width.
                    -->
                    <ItemsRepeater x:Name="ContinueRepeater">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                ItemsStretch="Fill"
                                MinColumnSpacing="16"
                                MinItemWidth="340"
                                MinRowSpacing="16" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:ContinueWatchingRecord">
                                <Button
                                    Click="ContinueCard_Click"
                                    Style="{StaticResource CardActionButtonStyle}"
                                    Tag="{x:Bind ShowId}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="112"
                                            Height="70"
                                            Style="{StaticResource ShowPosterSurfaceStyle}">
                                            <Border
                                                Width="24"
                                                Height="24"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="12">
                                                <FontIcon
                                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                    FontSize="10"
                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                    Glyph="&#xE768;" />
                                            </Border>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind ShowTitle}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <TextBlock
                                                Style="{StaticResource SecondaryCaptionTextStyle}"
                                                Text="{x:Bind EpisodeLine}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <!--
                        The row is empty until a show has an episode on disk. The designed strings for
                        that state exist, so the card states it instead of leaving a gap.
                    -->
                    <controls:EmptyStateCard
                        x:Name="ContinueEmptyState"
                        Glyph="&#xE768;"
                        Visibility="Collapsed" />
                </StackPanel>

                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="RecentHeadingText"
                            VerticalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Button
                            x:Name="SeeAllButton"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Click="SeeAllButton_Click"
                            Style="{StaticResource TextBlockButtonStyle}" />
                    </Grid>
                    <GridView
                        x:Name="RecentGrid"
                        ItemClick="RecentGrid_ItemClick"
                        ItemTemplate="{StaticResource MovieCardTemplate}"
                        Style="{StaticResource MediaGridViewStyle}">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid
                                    ItemHeight="{StaticResource MediaCardItemHeight}"
                                    ItemWidth="{StaticResource MediaCardItemWidth}"
                                    Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                    </GridView>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
