<!--
    My Lists.

    Mirrors PersonalLibrary.tsx: a page header (title + list count + accent New List) with the page
    search directly beneath it, the four-list tab strip where the active tab also shows its item
    count, then the list section (active list name + item count, Rename / Delete only for a user
    list) and the card grid.

    The page is full width on purpose: there is no content MaxWidth, so the ItemsWrapGrid below wraps
    cards across the whole area left of the sidebar instead of stopping at a fixed column.
-->
<Page
    x:Class="DropSort.UI.Views.MyListsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DropSort.UI.Controls"
    xmlns:models="using:DropSort.UI.Models"
    xmlns:local="using:DropSort.UI.Views"
    Background="Transparent">

    <!--
        The card grid owns its own scroll so its ItemsWrapGrid virtualizes; nesting a GridView in the page
        ScrollViewer realizes every card at once. Header, tabs and the active-list action row sit in a
        fixed Auto row; the grid fills the * row and scrolls internally.
    -->
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Padding="32,32,32,0"
            Spacing="20">
            <!--
                Page header command bar: the title and list count on the leading edge, and one aligned
                command group (Search this list, New List) on the trailing edge, so the controls read as
                one system. The title column takes the slack and trims first, so the command group stays
                aligned as the window narrows. New List is the primary (accent) action.
            -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <TextBlock
                        x:Name="PageTitleText"
                        Style="{StaticResource TitleTextBlockStyle}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="ListsCountText"
                        Margin="0,0,0,2"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource SecondaryCaptionTextStyle}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Width="260"
                        QueryIcon="Find"
                        Style="{StaticResource PageSearchBoxStyle}"
                        TextChanged="SearchBox_TextChanged" />
                    <Button
                        x:Name="NewListButton"
                        Click="NewListButton_Click"
                        Style="{StaticResource AccentControlButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="14"
                                Glyph="&#xE710;" />
                            <TextBlock x:Name="NewListButtonText" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!--
                Tab strip for the lists: grouped RadioButtons carrying the native selection visual
                (subtle hover fill plus a 2 epx accent underline) from TabStripItemStyle. Each tab
                declares its own icon, label and count in markup - the content of a tab is a
                UIElement, so it cannot come from a shared style - and code only fills in the text.
            -->
            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ListSelector" Style="{StaticResource TabStripStyle}">
                <RadioButton
                    x:Name="WatchLaterItem"
                    Checked="ListTab_Checked"
                    GroupName="MyListsSelector"
                    IsChecked="True"
                    Style="{StaticResource TabStripItemStyle}"
                    Tag="watch-later">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="14"
                            Glyph="&#xE8FD;" />
                        <TextBlock x:Name="WatchLaterLabel" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="WatchLaterCount"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryCaptionTextStyle}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    x:Name="FavoritesItem"
                    Checked="ListTab_Checked"
                    GroupName="MyListsSelector"
                    Style="{StaticResource TabStripItemStyle}"
                    Tag="favorites">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="14"
                            Glyph="&#xEB51;" />
                        <TextBlock x:Name="FavoritesLabel" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="FavoritesCount"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryCaptionTextStyle}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="ContinueWatchingItem" Checked="ListTab_Checked" GroupName="MyListsSelector"
                             Style="{StaticResource TabStripItemStyle}" Tag="continue-watching">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE768;" />
                        <TextBlock x:Name="ContinueWatchingLabel" VerticalAlignment="Center" />
                        <TextBlock x:Name="ContinueWatchingCount" VerticalAlignment="Center" Style="{StaticResource SecondaryCaptionTextStyle}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="RecentlyWatchedItem" Checked="ListTab_Checked" GroupName="MyListsSelector"
                             Style="{StaticResource TabStripItemStyle}" Tag="recently-watched">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE81C;" />
                        <TextBlock x:Name="RecentlyWatchedLabel" VerticalAlignment="Center" />
                        <TextBlock x:Name="RecentlyWatchedCount" VerticalAlignment="Center" Style="{StaticResource SecondaryCaptionTextStyle}" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            </ScrollViewer>

            <!--  Active list: name + item count, with the user-list only actions on the far side.  -->
            <Grid ColumnSpacing="12" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        x:Name="ListNameText"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ListCountText" Style="{StaticResource SecondaryCaptionTextStyle}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="AddMoviesButton"
                        Click="AddMoviesButton_Click"
                        Style="{StaticResource SubtleControlButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="14"
                                Glyph="&#xE710;" />
                            <TextBlock x:Name="AddMoviesButtonText" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="RenameListButton"
                        Click="RenameListButton_Click"
                        Style="{StaticResource SubtleControlButtonStyle}" />
                    <Button
                        x:Name="DeleteListButton"
                        Click="DeleteListButton_Click"
                        Style="{StaticResource SubtleControlButtonStyle}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="1">
            <controls:EmptyStateCard
                x:Name="EmptyState"
                Margin="32,24,32,40"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsFrameless="True"
                ActionClick="EmptyStateAction_Click"
                Glyph="&#xE728;"
                Visibility="Collapsed" />

            <GridView
                x:Name="ListGrid"
                Padding="32,12,32,48"
                HorizontalAlignment="Stretch"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollMode="Enabled"
                ItemClick="ListGrid_ItemClick"
                ItemTemplate="{StaticResource ListMovieCardTemplate}"
                ContextRequested="MediaGrid_ContextRequested"
                Style="{StaticResource MediaGridViewStyle}">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid
                            ItemHeight="{StaticResource MediaCardItemHeight}"
                            ItemWidth="{StaticResource MediaCardItemWidth}"
                            Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
            </GridView>
            <GridView x:Name="ContinueGrid" Padding="32,12,32,48" ItemClick="ActivityGrid_ItemClick" ContextRequested="MediaGrid_ContextRequested"
                      ItemContainerStyle="{StaticResource MediaHorizontalGridViewItemStyle}"
                      Style="{StaticResource MediaGridViewStyle}" Visibility="Collapsed"
                      ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollMode="Enabled">
                <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid ItemWidth="{StaticResource LibraryHorizontalFallbackCellWidth}" ItemHeight="{StaticResource LibraryHorizontalCellHeight}" Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:HomeActivityCard">
                        <Border
                                CornerRadius="{ThemeResource ControlCornerRadius}">
                            <Grid Background="{ThemeResource PosterMoviePlaceholderBrush}">
                                <Image Source="{x:Bind ArtworkSource, Mode=OneWay}" Stretch="UniformToFill" />
                                <Image Width="96" Height="144" Margin="12,8,12,0"
                                       HorizontalAlignment="Right" VerticalAlignment="Top"
                                       Source="{x:Bind PosterSource, Mode=OneWay}" Visibility="{x:Bind PosterVisibility, Mode=OneWay}"
                                       Stretch="Uniform" />
                                <Border Background="{ThemeResource LandscapeCardScrimBrush}" />
                                <StackPanel Margin="14" VerticalAlignment="Bottom" Spacing="3">
                                    <TextBlock Foreground="{ThemeResource LandscapeCardTextBrush}" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Foreground="{ThemeResource LandscapeCardSecondaryTextBrush}" Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind SecondaryLine}" />
                                    <TextBlock Foreground="{ThemeResource LandscapeCardSecondaryTextBrush}" Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind TypeLabel}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <GridView x:Name="HistoryGrid" Padding="32,12,32,48" ItemClick="ActivityGrid_ItemClick" ContextRequested="MediaGrid_ContextRequested"
                      ItemContainerStyle="{StaticResource MediaHorizontalGridViewItemStyle}"
                      Style="{StaticResource MediaGridViewStyle}" Visibility="Collapsed"
                      ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollMode="Enabled">
                <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid ItemWidth="{StaticResource LibraryHorizontalFallbackCellWidth}" ItemHeight="{StaticResource LibraryHorizontalCellHeight}" Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:WatchHistoryCardRecord">
                        <Border
                                CornerRadius="{ThemeResource ControlCornerRadius}">
                            <Grid Background="{ThemeResource PosterMoviePlaceholderBrush}">
                                <Image Source="{x:Bind ArtworkSource, Mode=OneWay}" Stretch="UniformToFill" />
                                <Border Background="{ThemeResource LandscapeCardScrimBrush}" />
                                <StackPanel Margin="14" VerticalAlignment="Bottom" Spacing="3">
                                    <TextBlock Foreground="{ThemeResource LandscapeCardTextBrush}" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Foreground="{ThemeResource LandscapeCardSecondaryTextBrush}" Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind Context}" />
                                    <TextBlock Foreground="{ThemeResource LandscapeCardSecondaryTextBrush}" Style="{StaticResource TertiaryCaptionTextStyle}" Text="{x:Bind WatchedAt}" />
                                    <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Style="{StaticResource TertiaryCaptionTextStyle}" Text="{x:Bind AvailabilityText}" Visibility="{x:Bind local:HomePage.UnavailableVisibility(IsAvailable)}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>
    </Grid>
</Page>
