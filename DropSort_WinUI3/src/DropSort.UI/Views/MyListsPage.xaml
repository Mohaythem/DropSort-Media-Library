<!--
    My Lists.

    Mirrors PersonalLibrary.tsx: a page header (title + list count + accent New List) with the page
    search directly beneath it, the four-list tab strip where the active tab also shows its item
    count, then the list section (active list name + item count, Rename / Delete only for a user
    list) and the card grid.

    The page is full width on purpose: there is no content MaxWidth, so the ItemsWrapGrid below wraps
    cards across the whole area left of the sidebar instead of stopping at a fixed column.
-->
<Page
    x:Class="DropSort.UI.Views.MyListsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DropSort.UI.Controls"
    Background="Transparent">

    <ScrollViewer x:Name="Root" Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel Spacing="20">
            <!--  Page header: title row, then the search box on its own line as in the design.  -->
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal"
                        Spacing="10">
                        <TextBlock
                            x:Name="PageTitleText"
                            Style="{StaticResource TitleTextBlockStyle}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="ListsCountText"
                            Margin="0,0,0,5"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource SecondaryCaptionTextStyle}" />
                    </StackPanel>

                    <Button
                        x:Name="NewListButton"
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Click="NewListButton_Click"
                        Style="{StaticResource AccentControlButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="14"
                                Glyph="&#xE710;" />
                            <TextBlock x:Name="NewListButtonText" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!--
                    The search box takes its width from this column, not from a style MaxWidth: a
                    stretched element under a MaxWidth would be centred instead of staying on the
                    leading edge. One star column capped at PageSearchMaxWidth gives the designed
                    ~320 epx on a desktop window, shrinks with the page, and sits at the leading
                    edge in both LTR and RTL without a margin.
                -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="{StaticResource PageSearchMaxWidth}" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        QueryIcon="Find"
                        Style="{StaticResource PageSearchBoxStyle}"
                        TextChanged="SearchBox_TextChanged" />
                </Grid>
            </StackPanel>

            <!--
                Tab strip for the lists: grouped RadioButtons carrying the native selection visual
                (subtle hover fill plus a 2 epx accent underline) from TabStripItemStyle. Each tab
                declares its own icon, label and count in markup - the content of a tab is a
                UIElement, so it cannot come from a shared style - and code only fills in the text.
            -->
            <StackPanel x:Name="ListSelector" Style="{StaticResource TabStripStyle}">
                <RadioButton
                    x:Name="WatchlistItem"
                    Checked="ListTab_Checked"
                    GroupName="MyListsSelector"
                    IsChecked="True"
                    Style="{StaticResource TabStripItemStyle}"
                    Tag="watchlist">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="14"
                            Glyph="&#xE734;" />
                        <TextBlock x:Name="WatchlistLabel" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="WatchlistCount"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryCaptionTextStyle}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    x:Name="FavoritesItem"
                    Checked="ListTab_Checked"
                    GroupName="MyListsSelector"
                    Style="{StaticResource TabStripItemStyle}"
                    Tag="favorites">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="14"
                            Glyph="&#xEB51;" />
                        <TextBlock x:Name="FavoritesLabel" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="FavoritesCount"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryCaptionTextStyle}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    x:Name="WatchLaterItem"
                    Checked="ListTab_Checked"
                    GroupName="MyListsSelector"
                    Style="{StaticResource TabStripItemStyle}"
                    Tag="watch-later">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="14"
                            Glyph="&#xE8FD;" />
                        <TextBlock x:Name="WatchLaterLabel" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="WatchLaterCount"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryCaptionTextStyle}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    x:Name="ThrillersItem"
                    Checked="ListTab_Checked"
                    GroupName="MyListsSelector"
                    Style="{StaticResource TabStripItemStyle}"
                    Tag="thrillers">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="14"
                            Glyph="&#xE8FD;" />
                        <TextBlock x:Name="ThrillersLabel" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="ThrillersCount"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryCaptionTextStyle}" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <!--  Active list: name + item count, with the user-list only actions on the far side.  -->
            <StackPanel Spacing="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            x:Name="ListNameText"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ListCountText" Style="{StaticResource SecondaryCaptionTextStyle}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="RenameListButton"
                            Click="RenameListButton_Click"
                            Style="{StaticResource SubtleControlButtonStyle}" />
                        <Button
                            x:Name="DeleteListButton"
                            Click="DeleteListButton_Click"
                            Style="{StaticResource SubtleControlButtonStyle}" />
                    </StackPanel>
                </Grid>

                <controls:EmptyStateCard
                    x:Name="EmptyState"
                    ActionClick="EmptyStateAction_Click"
                    Glyph="&#xE728;"
                    Visibility="Collapsed" />

                <GridView
                    x:Name="ListGrid"
                    ItemClick="ListGrid_ItemClick"
                    ItemTemplate="{StaticResource ListMovieCardTemplate}"
                    Style="{StaticResource MediaGridViewStyle}">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid
                                ItemHeight="{StaticResource MediaCardItemHeight}"
                                ItemWidth="{StaticResource MediaCardItemWidth}"
                                Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
