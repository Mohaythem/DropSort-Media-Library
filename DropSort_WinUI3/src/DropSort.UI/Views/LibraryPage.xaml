<Page
    x:Class="DropSort.UI.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DropSort.UI.Controls"
    Background="Transparent">

    <ScrollViewer x:Name="Root" Style="{StaticResource PageScrollViewerStyle}">
        <!--  The library grid is full-bleed, so this page intentionally has no content MaxWidth.  -->
        <StackPanel Spacing="20">
            <!--
                Page header command bar: the title and result count on the leading edge, and one
                aligned command group (Search, Sort, Filter) on the trailing edge, so the controls read
                as one system. The title column takes the slack and trims first, so the command group
                stays aligned as the window narrows.
            -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <TextBlock
                        x:Name="PageTitleText"
                        Style="{StaticResource TitleTextBlockStyle}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="CountText"
                        Margin="0,0,0,2"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource SecondaryCaptionTextStyle}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Width="260"
                        QueryIcon="Find"
                        Style="{StaticResource PageSearchBoxStyle}"
                        TextChanged="SearchBox_TextChanged" />
                    <!--
                        Sort reads as one control: a split button whose face shows the active criterion
                        and its direction (e.g. "Date added ↓"). Pressing the face reverses the direction;
                        the dropdown chevron opens the criteria list. This keeps the Search + Sort + Filter
                        group aligned without a separate direction button.
                    -->
                    <SplitButton x:Name="SortButton" Click="SortSplit_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="SortButtonText" VerticalAlignment="Center" />
                            <FontIcon
                                x:Name="SortDirectionGlyph"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="12"
                                Glyph="&#xE70D;" />
                        </StackPanel>
                        <SplitButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <RadioMenuFlyoutItem
                                    x:Name="SortAddedItem"
                                    Click="SortItem_Click"
                                    GroupName="LibrarySort"
                                    IsChecked="True"
                                    Tag="added" />
                                <RadioMenuFlyoutItem
                                    x:Name="SortTitleItem"
                                    Click="SortItem_Click"
                                    GroupName="LibrarySort"
                                    Tag="title" />
                                <RadioMenuFlyoutItem
                                    x:Name="SortYearItem"
                                    Click="SortItem_Click"
                                    GroupName="LibrarySort"
                                    Tag="year" />
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                    <Button
                        x:Name="FilterButton"
                        Style="{StaticResource SubtleControlButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="14"
                                Glyph="&#xE71C;" />
                            <TextBlock x:Name="FilterButtonText" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <RadioMenuFlyoutItem
                                    x:Name="FilterAllItem"
                                    Click="FilterItem_Click"
                                    GroupName="LibraryAvailability"
                                    IsChecked="True"
                                    Tag="all" />
                                <RadioMenuFlyoutItem
                                    x:Name="FilterLocalItem"
                                    Click="FilterItem_Click"
                                    GroupName="LibraryAvailability"
                                    Tag="local" />
                                <RadioMenuFlyoutItem
                                    x:Name="FilterRemoteItem"
                                    Click="FilterItem_Click"
                                    GroupName="LibraryAvailability"
                                    Tag="remote" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <!--  Media-type tabs, below the header command bar and aligned with the content.  -->
            <StackPanel x:Name="MediaTypeSelector" Style="{StaticResource TabStripStyle}">
                <RadioButton
                    x:Name="MoviesTypeItem"
                    Checked="MediaTypeItem_Checked"
                    GroupName="LibraryMediaType"
                    IsChecked="True"
                    Style="{StaticResource TabStripItemStyle}"
                    Tag="movies" />
                <RadioButton
                    x:Name="ShowsTypeItem"
                    Checked="MediaTypeItem_Checked"
                    GroupName="LibraryMediaType"
                    Style="{StaticResource TabStripItemStyle}"
                    Tag="shows" />
            </StackPanel>

            <StackPanel
                x:Name="LoadingPanel"
                Orientation="Horizontal"
                Spacing="12"
                Visibility="Collapsed">
                <ProgressRing
                    Width="20"
                    Height="20"
                    IsActive="True" />
                <TextBlock
                    x:Name="LoadingText"
                    VerticalAlignment="Center"
                    Style="{StaticResource SecondaryBodyTextStyle}" />
            </StackPanel>

            <controls:EmptyStateCard
                x:Name="ErrorState"
                ActionClick="ErrorRetry_Click"
                Glyph="&#xEA39;"
                IsActionVisible="True"
                Visibility="Collapsed" />

            <controls:EmptyStateCard
                x:Name="EmptyState"
                ActionClick="EmptyStateAction_Click"
                Glyph="&#xE721;"
                Visibility="Collapsed" />

            <GridView
                x:Name="MoviesGrid"
                ItemClick="MoviesGrid_ItemClick"
                ItemTemplate="{StaticResource MovieCardTemplate}"
                Style="{StaticResource MediaGridViewStyle}">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid
                            ItemHeight="{StaticResource MediaCardItemHeight}"
                            ItemWidth="{StaticResource MediaCardItemWidth}"
                            Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
            </GridView>

            <GridView
                x:Name="ShowsGrid"
                ItemClick="ShowsGrid_ItemClick"
                ItemTemplate="{StaticResource ShowCardTemplate}"
                Style="{StaticResource MediaGridViewStyle}"
                Visibility="Collapsed">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid
                            ItemHeight="{StaticResource ShowCardItemHeight}"
                            ItemWidth="{StaticResource MediaCardItemWidth}"
                            Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
            </GridView>
        </StackPanel>
    </ScrollViewer>
</Page>
