<Page
    x:Class="DropSort.UI.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DropSort.UI.Controls"
    Background="Transparent">

    <ScrollViewer x:Name="Root" Style="{StaticResource PageScrollViewerStyle}">
        <!--  The library grid is full-bleed, so this page intentionally has no content MaxWidth.  -->
        <StackPanel Spacing="20">
            <!--
                Page header, as in the design source: title + result count with the Sort control as
                the header action, and the search box on its own line directly underneath.
            -->
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal"
                        Spacing="10">
                        <TextBlock
                            x:Name="PageTitleText"
                            Style="{StaticResource TitleTextBlockStyle}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="CountText"
                            Margin="0,0,0,5"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource SecondaryCaptionTextStyle}" />
                    </StackPanel>

                    <Button
                        x:Name="SortButton"
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource SubtleControlButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="14"
                                Glyph="&#xE8CB;" />
                            <TextBlock x:Name="SortButtonText" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <RadioMenuFlyoutItem
                                    x:Name="SortAddedItem"
                                    Click="SortItem_Click"
                                    GroupName="LibrarySort"
                                    IsChecked="True"
                                    Tag="added" />
                                <RadioMenuFlyoutItem
                                    x:Name="SortTitleItem"
                                    Click="SortItem_Click"
                                    GroupName="LibrarySort"
                                    Tag="title" />
                                <RadioMenuFlyoutItem
                                    x:Name="SortYearItem"
                                    Click="SortItem_Click"
                                    GroupName="LibrarySort"
                                    Tag="year" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <!--
                    The search box is sized by this column, not by a MaxWidth on the control: a
                    stretched element under a max constraint is centred, while a single star column
                    capped at PageSearchMaxWidth keeps it on the leading edge in LTR and RTL and lets
                    it shrink with a narrow window.
                -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="{StaticResource PageSearchMaxWidth}" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        QueryIcon="Find"
                        Style="{StaticResource PageSearchBoxStyle}"
                        TextChanged="SearchBox_TextChanged" />
                </Grid>
            </StackPanel>

            <!--  Command row: media-type tabs on the leading edge, Filter on the trailing one.  -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="MediaTypeSelector" Style="{StaticResource TabStripStyle}">
                    <RadioButton
                        x:Name="MoviesTypeItem"
                        Checked="MediaTypeItem_Checked"
                        GroupName="LibraryMediaType"
                        IsChecked="True"
                        Style="{StaticResource TabStripItemStyle}"
                        Tag="movies" />
                    <RadioButton
                        x:Name="ShowsTypeItem"
                        Checked="MediaTypeItem_Checked"
                        GroupName="LibraryMediaType"
                        Style="{StaticResource TabStripItemStyle}"
                        Tag="shows" />
                </StackPanel>

                <Button
                    x:Name="FilterButton"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource SubtleControlButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="14"
                            Glyph="&#xE71C;" />
                        <TextBlock x:Name="FilterButtonText" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <RadioMenuFlyoutItem
                                x:Name="FilterAllItem"
                                Click="FilterItem_Click"
                                GroupName="LibraryAvailability"
                                IsChecked="True"
                                Tag="all" />
                            <RadioMenuFlyoutItem
                                x:Name="FilterLocalItem"
                                Click="FilterItem_Click"
                                GroupName="LibraryAvailability"
                                Tag="local" />
                            <RadioMenuFlyoutItem
                                x:Name="FilterRemoteItem"
                                Click="FilterItem_Click"
                                GroupName="LibraryAvailability"
                                Tag="remote" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <StackPanel
                x:Name="LoadingPanel"
                Orientation="Horizontal"
                Spacing="12"
                Visibility="Collapsed">
                <ProgressRing
                    Width="20"
                    Height="20"
                    IsActive="True" />
                <TextBlock
                    x:Name="LoadingText"
                    VerticalAlignment="Center"
                    Style="{StaticResource SecondaryBodyTextStyle}" />
            </StackPanel>

            <controls:EmptyStateCard
                x:Name="ErrorState"
                ActionClick="ErrorRetry_Click"
                Glyph="&#xEA39;"
                IsActionVisible="True"
                Visibility="Collapsed" />

            <controls:EmptyStateCard
                x:Name="EmptyState"
                ActionClick="EmptyStateAction_Click"
                Glyph="&#xE721;"
                Visibility="Collapsed" />

            <GridView
                x:Name="MoviesGrid"
                ItemClick="MoviesGrid_ItemClick"
                ItemTemplate="{StaticResource MovieCardTemplate}"
                Style="{StaticResource MediaGridViewStyle}">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid
                            ItemHeight="{StaticResource MediaCardItemHeight}"
                            ItemWidth="{StaticResource MediaCardItemWidth}"
                            Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
            </GridView>

            <GridView
                x:Name="ShowsGrid"
                ItemClick="ShowsGrid_ItemClick"
                ItemTemplate="{StaticResource ShowCardTemplate}"
                Style="{StaticResource MediaGridViewStyle}"
                Visibility="Collapsed">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid
                            ItemHeight="{StaticResource ShowCardItemHeight}"
                            ItemWidth="{StaticResource MediaCardItemWidth}"
                            Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
            </GridView>
        </StackPanel>
    </ScrollViewer>
</Page>
