<Page
    x:Class="DropSort.UI.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DropSort.UI.Controls"
    xmlns:models="using:DropSort.UI.Models"
    Background="Transparent">

    <Page.Resources>
        <ItemsPanelTemplate x:Key="LibraryMoviePosterItemsPanel">
            <ItemsWrapGrid ItemHeight="{StaticResource MediaCardItemHeight}" ItemWidth="{StaticResource MediaCardItemWidth}" Orientation="Horizontal" EffectiveViewportChanged="HorizontalPanel_EffectiveViewportChanged" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="LibraryShowPosterItemsPanel">
            <ItemsWrapGrid ItemHeight="{StaticResource ShowCardItemHeight}" ItemWidth="{StaticResource MediaCardItemWidth}" Orientation="Horizontal" EffectiveViewportChanged="HorizontalPanel_EffectiveViewportChanged" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="LibraryHorizontalItemsPanel">
            <ItemsWrapGrid ItemHeight="{StaticResource LibraryHorizontalCellHeight}" ItemWidth="{StaticResource LibraryHorizontalFallbackCellWidth}" Orientation="Horizontal" EffectiveViewportChanged="HorizontalPanel_EffectiveViewportChanged" />
        </ItemsPanelTemplate>

        <!-- Library-only adaptive posters. Shared templates retain their fixed geometry. -->
        <DataTemplate x:Key="LibraryMovieCardTemplate" x:DataType="models:MovieRecord">
            <StackPanel Spacing="8">
                <Border
                    Height="{StaticResource MediaCardPosterHeight}"
                    HorizontalAlignment="Stretch" SizeChanged="PosterSurface_SizeChanged" Style="{StaticResource PosterSurfaceStyle}">
                    <Grid>
                        <Image Source="{x:Bind PosterSource, Mode=OneWay}" Stretch="UniformToFill" />
                        <!--
                            Graceful fallback when there is no poster/metadata: an inset, bordered panel that
                            shows the title clearly inside the poster area. The margin keeps the border off the
                            card edges; theme brushes keep it readable in light and dark. Not an error state.
                        -->
                        <Border
                            Margin="12"
                            Background="{ThemeResource LayerFillColorAltBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Padding="12"
                            Visibility="{x:Bind IsPosterMissing, Mode=OneWay}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxLines="4"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Title}"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                        </Border>
                        <!--
                            Subtle multi-file badge: shown only when the movie owns more than one local file
                            (multiple versions/copies). The per-file detail lives in Movie Details.
                        -->
                        <Border
                            Margin="8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="{ThemeResource LayerFillColorAltBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Padding="8,2,8,2"
                            Visibility="{x:Bind MultiFileBadgeVisibility, Mode=OneWay}">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind MultiFileBadgeText, Mode=OneWay}" />
                        </Border>
                        <!--
                            "Review match" badge: metadata is present but was auto-picked from a close match, so
                            a glance is recommended. Distinct from a no-metadata card.
                        -->
                        <Border
                            Margin="8"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Background="{ThemeResource LayerFillColorAltBrush}"
                            BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Padding="8,2,8,2"
                            Visibility="{x:Bind ReviewMatchBadgeVisibility, Mode=OneWay}">
                            <TextBlock
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ReviewMatchLabel, Mode=OneWay}" />
                        </Border>
                    </Grid>
                </Border>
                <TextBlock
                    Height="{StaticResource MediaCardTitleHeight}"
                    MaxLines="2"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind Title}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="LibraryShowCardTemplate" x:DataType="models:ShowCardItem">
            <StackPanel Spacing="8">
                <Border
                    Height="{StaticResource MediaCardPosterHeight}"
                    HorizontalAlignment="Stretch" SizeChanged="PosterSurface_SizeChanged" Style="{StaticResource ShowPosterSurfaceStyle}">
                    <Grid>
                        <Image Source="{x:Bind PosterSource, Mode=OneWay}" Stretch="UniformToFill" />
                        <FontIcon
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="40"
                            Foreground="{ThemeResource PosterGlyphForegroundBrush}"
                            Glyph="&#xE7F4;"
                            Visibility="{x:Bind IsPosterMissing, Mode=OneWay}" />
                    </Grid>
                </Border>
                <StackPanel Spacing="2">
                    <TextBlock
                        Height="{StaticResource MediaCardTitleHeight}"
                        MaxLines="2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Style="{StaticResource SecondaryCaptionTextStyle}"
                        Text="{x:Bind SecondaryLine}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <!--
        The library grid must own its own scroll so its ItemsWrapGrid virtualizes. A GridView nested in a
        page ScrollViewer is given unbounded height and realizes every item (all 10K cards at once), which
        was a primary cause of the large-library hang. The header and tabs sit in a fixed Auto row; the
        grids fill the * row and scroll internally.
    -->
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Padding="32,32,32,0"
            Spacing="20">
            <!--
                Page header command bar: the title and result count on the leading edge, and one
                aligned command group (Search, Sort, Filter) on the trailing edge, so the controls read
                as one system. The title column takes the slack and trims first, so the command group
                stays aligned as the window narrows.
            -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <TextBlock
                        x:Name="PageTitleText"
                        Style="{StaticResource TitleTextBlockStyle}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="CountText"
                        Margin="0,0,0,2"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource SecondaryCaptionTextStyle}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Width="260"
                        QueryIcon="Find"
                        Style="{StaticResource PageSearchBoxStyle}"
                        TextChanged="SearchBox_TextChanged" />
                    <!--
                        Sort reads as one control: a split button whose face shows the active criterion
                        and its direction (e.g. "Date added ↓"). Pressing the face reverses the direction;
                        the dropdown chevron opens the criteria list. This keeps the Search + Sort + Filter
                        group aligned without a separate direction button.
                    -->
                    <SplitButton x:Name="SortButton" Click="SortSplit_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="SortButtonText" VerticalAlignment="Center" />
                            <FontIcon
                                x:Name="SortDirectionGlyph"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="12"
                                Glyph="&#xE70D;" />
                        </StackPanel>
                        <SplitButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <RadioMenuFlyoutItem
                                    x:Name="SortAddedItem"
                                    Click="SortItem_Click"
                                    GroupName="LibrarySort"
                                    IsChecked="False"
                                    Tag="added" />
                                <RadioMenuFlyoutItem
                                    x:Name="SortRecentItem"
                                    Click="SortItem_Click"
                                    GroupName="LibrarySort"
                                    IsChecked="True"
                                    Tag="recent" />
                                <RadioMenuFlyoutItem
                                    x:Name="SortTitleItem"
                                    Click="SortItem_Click"
                                    GroupName="LibrarySort"
                                    Tag="title" />
                                <RadioMenuFlyoutItem
                                    x:Name="SortYearItem"
                                    Click="SortItem_Click"
                                    GroupName="LibrarySort"
                                    Tag="year" />
                                <RadioMenuFlyoutItem
                                    x:Name="SortMetadataItem"
                                    Click="SortItem_Click"
                                    GroupName="LibrarySort"
                                    Tag="metadata" />
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                    <Button
                        x:Name="FilterButton"
                        Style="{StaticResource SubtleControlButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="14"
                                Glyph="&#xE71C;" />
                            <TextBlock x:Name="FilterButtonText" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <RadioMenuFlyoutItem
                                    x:Name="FilterAllItem"
                                    Click="FilterItem_Click"
                                    GroupName="LibraryAvailability"
                                    IsChecked="True"
                                    Tag="all" />
                                <RadioMenuFlyoutItem
                                    x:Name="FilterLocalItem"
                                    Click="FilterItem_Click"
                                    GroupName="LibraryAvailability"
                                    Tag="local" />
                                <RadioMenuFlyoutItem
                                    x:Name="FilterRemoteItem"
                                    Click="FilterItem_Click"
                                    GroupName="LibraryAvailability"
                                    Tag="remote" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <!--  Media-type tabs, below the header command bar and aligned with the content.  -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="MediaTypeSelector" Style="{StaticResource TabStripStyle}">
                    <RadioButton
                        x:Name="MoviesTypeItem"
                        Checked="MediaTypeItem_Checked"
                        GroupName="LibraryMediaType"
                        IsChecked="True"
                        Style="{StaticResource TabStripItemStyle}"
                        Tag="movies" />
                    <RadioButton
                        x:Name="ShowsTypeItem"
                        Checked="MediaTypeItem_Checked"
                        GroupName="LibraryMediaType"
                        Style="{StaticResource TabStripItemStyle}"
                        Tag="shows" />
                </StackPanel>
                <SelectorBar
                    x:Name="ViewModeSelector"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="LibraryViewMode"
                    HorizontalAlignment="Right"
                    SelectionChanged="ViewModeSelector_SelectionChanged">
                    <SelectorBarItem
                        x:Name="GridViewModeItem"
                        AutomationProperties.AutomationId="LibraryGridViewMode"
                        Tag="grid">
                        <SelectorBarItem.Icon>
                            <SymbolIcon Symbol="ViewAll" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem
                        x:Name="CompactViewModeItem"
                        AutomationProperties.AutomationId="LibraryCompactViewMode"
                        Tag="compact">
                        <SelectorBarItem.Icon>
                            <SymbolIcon Symbol="List" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                </SelectorBar>
            </Grid>

            <StackPanel
                x:Name="LoadingPanel"
                Orientation="Horizontal"
                Spacing="12"
                Visibility="Collapsed">
                <ProgressRing
                    Width="20"
                    Height="20"
                    IsActive="True" />
                <TextBlock
                    x:Name="LoadingText"
                    VerticalAlignment="Center"
                    Style="{StaticResource SecondaryBodyTextStyle}" />
            </StackPanel>

            <controls:EmptyStateCard
                x:Name="ErrorState"
                ActionClick="ErrorRetry_Click"
                Glyph="&#xEA39;"
                IsActionVisible="True"
                Visibility="Collapsed" />
        </StackPanel>

        <Grid Grid.Row="1">
            <controls:EmptyStateCard
                x:Name="EmptyState"
                Margin="32,12,32,0"
                VerticalAlignment="Top"
                ActionClick="EmptyStateAction_Click"
                Glyph="&#xE721;"
                Visibility="Collapsed" />

            <GridView
                x:Name="MoviesGrid"
                Padding="32,12,32,48"
                HorizontalAlignment="Stretch"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollMode="Enabled"
                ItemClick="MoviesGrid_ItemClick"
                ItemTemplate="{StaticResource MovieCardTemplate}"
                Style="{StaticResource MediaGridViewStyle}"
                ItemsPanel="{StaticResource LibraryMoviePosterItemsPanel}"
                Loaded="LibraryGrid_Loaded"
                SizeChanged="LibraryGrid_SizeChanged">
            </GridView>

            <GridView
                x:Name="ShowsGrid"
                Padding="32,12,32,48"
                HorizontalAlignment="Stretch"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollMode="Enabled"
                ItemClick="ShowsGrid_ItemClick"
                ItemTemplate="{StaticResource ShowCardTemplate}"
                Style="{StaticResource MediaGridViewStyle}"
                Visibility="Collapsed"
                ItemsPanel="{StaticResource LibraryShowPosterItemsPanel}"
                Loaded="LibraryGrid_Loaded"
                SizeChanged="LibraryGrid_SizeChanged">
            </GridView>
        </Grid>
    </Grid>
</Page>
