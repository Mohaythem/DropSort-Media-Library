<!--
    TV show details.

    Mirrors TVShowDetails.tsx / index.css: hero band (2:3 poster + 720 px copy column, progress
    line, Play Next Episode / Add to List / more), then the seasons stack. Each season is a native
    Expander whose header is the designed season card and whose content is the episode thread.
-->
<Page
    x:Class="DropSort.UI.Views.TVShowDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DropSort.UI.Models"
    Background="Transparent">

    <ScrollViewer x:Name="Root" Style="{StaticResource PageScrollViewerStyle}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ShowWidthStates">
                <VisualState x:Name="ShowWideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1180" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PosterSurface.Width" Value="200" />
                        <Setter Target="PosterSurface.Height" Value="300" />
                        <Setter Target="PosterGlyph.FontSize" Value="48" />
                        <Setter Target="ActionsPanel.Orientation" Value="Horizontal" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ShowMediumState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ActionsPanel.Orientation" Value="Horizontal" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ShowCompactState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    x:Name="ContentColumn"
                    Width="*"
                    MaxWidth="{StaticResource PageContentMaxWidth}" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <Button
                    x:Name="BackButton"
                    Click="BackButton_Click"
                    Style="{StaticResource BackNavigationButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="14"
                            Glyph="&#xE72B;"
                            MirroredWhenRightToLeft="True" />
                        <TextBlock x:Name="BackText" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border
                    BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,0,0,24">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition
                                x:Name="HeroCopyColumn"
                                Width="*"
                                MaxWidth="720" />
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="PosterSurface"
                            Width="148"
                            Height="222"
                            VerticalAlignment="Top"
                            Style="{StaticResource ShowPosterSurfaceStyle}">
                            <Grid>
                                <Image x:Name="PosterImage" Stretch="UniformToFill" />
                                <FontIcon
                                    x:Name="PosterGlyph"
                                    FontSize="36"
                                    Foreground="{ThemeResource PosterGlyphForegroundBrush}"
                                    Glyph="&#xE7F4;" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock x:Name="KindText" Style="{StaticResource SecondaryCaptionTextStyle}" />
                            <TextBlock
                                x:Name="ShowTitleText"
                                Style="{StaticResource TitleTextBlockStyle}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="ShowMetaText"
                                Style="{StaticResource SecondaryBodyTextStyle}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="OverviewText"
                                MaxWidth="{StaticResource ProseMaxWidth}"
                                HorizontalAlignment="Left"
                                Style="{StaticResource SecondaryBodyTextStyle}"
                                TextWrapping="Wrap" />
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Bottom">
                                <TextBlock x:Name="ProgressValueText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    x:Name="ProgressLabelText"
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource SecondaryCaptionTextStyle}" />
                            </StackPanel>
                            <StackPanel
                                x:Name="ActionsPanel"
                                Margin="0,4,0,0"
                                Orientation="Vertical"
                                Spacing="8">
                                <Button
                                    x:Name="PlayNextButton"
                                    Click="PlayNextButton_Click"
                                    Style="{StaticResource AccentControlButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Glyph="&#xE768;" />
                                        <TextBlock x:Name="PlayNextText" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="AddToListButton"
                                    IsEnabled="False"
                                    Style="{StaticResource SubtleControlButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Glyph="&#xE710;" />
                                        <TextBlock x:Name="AddToListText" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="MatchButton"
                                    Click="MatchButton_Click"
                                    Style="{StaticResource SubtleControlButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon
                                            x:Name="MatchGlyph"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Glyph="&#xE721;" />
                                        <ProgressRing
                                            x:Name="MatchProgress"
                                            Width="14"
                                            Height="14"
                                            VerticalAlignment="Center"
                                            IsActive="False"
                                            Visibility="Collapsed" />
                                        <TextBlock x:Name="MatchText" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="MoreButton" Style="{StaticResource SubtleIconActionButtonStyle}">
                                    <FontIcon FontSize="16" Glyph="&#xE712;" />
                                    <Button.Flyout>
                                        <MenuFlyout Placement="Bottom">
                                            <MenuFlyoutItem x:Name="MarkShowWatchedItem" IsEnabled="False">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE73E;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="OpenShowFolderItem" IsEnabled="False">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8B7;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <StackPanel Margin="0,32,0,0" Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="SeasonsTitleText" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            x:Name="SeasonsHelpText"
                            Style="{StaticResource SecondaryCaptionTextStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ItemsRepeater x:Name="SeasonsRepeater">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:SeasonDisplayRecord">
                                <Expander
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    IsExpanded="{x:Bind IsExpanded}"
                                    Tag="{x:Bind}">
                                    <Expander.Header>
                                        <!--
                                            One season component: badge, then the title block, then
                                            the progress track. The row is 64 epx tall with 20 epx
                                            between the three parts and 8 epx of air above and below,
                                            so the badge no longer touches the title, the title and
                                            its meta line each keep a full line box, and the track
                                            keeps its distance from the Expander's own chevron. Every
                                            value is a margin or a gap on this grid - nothing is
                                            positioned per language, so the row mirrors as a whole
                                            under RTL.
                                        -->
                                        <Grid
                                            MinHeight="64"
                                            Margin="0,8"
                                            ColumnSpacing="20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <!--
                                                    The progress track takes a share of the row rather
                                                    than a fixed 160 epx, capped so it never grows past
                                                    the designed width. A fixed track was squeezing the
                                                    title block on a narrow window; this way the track
                                                    gives room back instead.
                                                -->
                                                <ColumnDefinition Width="0.4*" MaxWidth="172" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Width="52"
                                                Height="52"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource TileSurfaceStyle}">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                    Text="{x:Bind ArtLabel}" />
                                            </Border>
                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="6">
                                                <TextBlock
                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                    Text="{x:Bind Title}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                                    Text="{x:Bind Meta}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <ProgressBar
                                                Grid.Column="2"
                                                Height="4"
                                                MinWidth="72"
                                                Margin="0,0,12,0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"
                                                Maximum="100"
                                                Value="{x:Bind ProgressValue}" />
                                        </Grid>
                                    </Expander.Header>
                                    <!--
                                        .episode-thread: inset with a hairline rail, mirrored under
                                        RTL. The bottom padding matches the top so the last episode
                                        card is not flush against the season card's edge.
                                    -->
                                    <Border
                                        Margin="26,0,0,0"
                                        BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}"
                                        BorderThickness="1,0,0,0"
                                        Padding="24,12,0,12">
                                        <ItemsRepeater ItemsSource="{x:Bind Episodes}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Spacing="8" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="models:EpisodeDisplayRecord">
                                                    <Border
                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{ThemeResource ControlCornerRadius}"
                                                        Padding="12,8,12,8">
                                                        <Grid MinHeight="52" ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border
                                                                Width="88"
                                                                Height="50"
                                                                VerticalAlignment="Center"
                                                                Style="{StaticResource TileSurfaceStyle}">
                                                                <TextBlock
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                                                    Text="{x:Bind ThumbnailLabel}" />
                                                            </Border>
                                                            <StackPanel
                                                                Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                Spacing="2">
                                                                <TextBlock
                                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                    Text="{x:Bind Title}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                                                    Text="{x:Bind Meta}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <StackPanel
                                                                Grid.Column="2"
                                                                Orientation="Horizontal"
                                                                Spacing="8"
                                                                VerticalAlignment="Center">
                                                                <Border Style="{StaticResource StatusPillStyle}" Visibility="{x:Bind Watched}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                                        <FontIcon
                                                                            VerticalAlignment="Center"
                                                                            FontSize="12"
                                                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                                            Glyph="&#xE73E;" />
                                                                        <TextBlock
                                                                            VerticalAlignment="Center"
                                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                                            Text="{x:Bind Labels.Watched}" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border Style="{StaticResource StatusPillStyle}" Visibility="{x:Bind IsMissing}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                                        <FontIcon
                                                                            VerticalAlignment="Center"
                                                                            FontSize="12"
                                                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                                            Glyph="&#xE7BA;" />
                                                                        <TextBlock
                                                                            VerticalAlignment="Center"
                                                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                                            Text="{x:Bind Labels.Missing}" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>
                                                            <StackPanel
                                                                Grid.Column="3"
                                                                Orientation="Horizontal"
                                                                Spacing="4"
                                                                VerticalAlignment="Center">
                                                                <Button
                                                                    AutomationProperties.Name="{x:Bind Labels.Play}"
                                                                    Click="EpisodePlay_Click"
                                                                    IsEnabled="{x:Bind HasLocalFile}"
                                                                    Style="{StaticResource SubtleIconActionButtonStyle}"
                                                                    Tag="{x:Bind}"
                                                                    ToolTipService.ToolTip="{x:Bind Labels.Play}">
                                                                    <FontIcon FontSize="14" Glyph="&#xE768;" />
                                                                </Button>
                                                                <Button
                                                                    AutomationProperties.Name="{x:Bind Labels.OpenFolder}"
                                                                    Click="EpisodeOpenFolder_Click"
                                                                    IsEnabled="{x:Bind HasLocalFile}"
                                                                    Style="{StaticResource SubtleIconActionButtonStyle}"
                                                                    Tag="{x:Bind}"
                                                                    ToolTipService.ToolTip="{x:Bind Labels.OpenFolder}">
                                                                    <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                                                                </Button>
                                                                <Button
                                                                    AutomationProperties.Name="{x:Bind Labels.More}"
                                                                    Click="EpisodeDetails_Click"
                                                                    Style="{StaticResource SubtleIconActionButtonStyle}"
                                                                    Tag="{x:Bind}"
                                                                    ToolTipService.ToolTip="{x:Bind Labels.More}">
                                                                    <FontIcon FontSize="14" Glyph="&#xE712;" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </Border>
                                </Expander>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
