<Page
    x:Class="DropSort.UI.Views.CheckLibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DropSort.UI.Controls"
    xmlns:models="using:DropSort.UI.Models"
    Background="Transparent">

    <ScrollViewer x:Name="Root" Style="{StaticResource PageScrollViewerStyle}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CheckWidthStates">
                <VisualState x:Name="CheckWideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentColumn.MaxWidth" Value="{StaticResource CheckLibraryWideMaxWidth}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckNarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentColumn.MaxWidth" Value="{StaticResource CheckLibraryContentMaxWidth}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    x:Name="ContentColumn"
                    Width="*"
                    MaxWidth="{StaticResource CheckLibraryContentMaxWidth}" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="24">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="PageTitleText" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock
                        x:Name="DescriptionText"
                        Style="{StaticResource SecondaryBodyTextStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!--  .check-shield: the designed status tile that fronts the card.  -->
                            <Border
                                Width="48"
                                Height="48"
                                VerticalAlignment="Center"
                                Style="{StaticResource TileSurfaceStyle}">
                                <FontIcon
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    FontSize="20"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE72E;" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="4">
                                <TextBlock x:Name="CheckHeadingText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    x:Name="CheckHelpText"
                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                                <Button
                                    x:Name="CancelCheckButton"
                                    Click="CancelCheckButton_Click"
                                    Style="{StaticResource SubtleControlButtonStyle}"
                                    Visibility="Collapsed" />
                                <Button
                                    x:Name="RunCheckButton"
                                    Click="RunCheckButton_Click"
                                    Style="{StaticResource AccentControlButtonStyle}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="CheckProgressPanel" Spacing="8" Visibility="Collapsed">
                            <TextBlock x:Name="CheckProgressText" Style="{StaticResource SecondaryCaptionTextStyle}" />
                            <ProgressBar x:Name="CheckProgressBar" Height="4" />
                        </StackPanel>

                        <StackPanel x:Name="CheckSummaryPanel" Spacing="12" Visibility="Collapsed">
                            <Border Style="{StaticResource HairlineDividerStyle}" />
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="SummaryHeadingText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    x:Name="SummaryHelpText"
                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="32">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        x:Name="PassedValueText"
                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                        Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock x:Name="PassedLabelText" Style="{StaticResource SecondaryCaptionTextStyle}" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        x:Name="AttentionValueText"
                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                        Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock x:Name="AttentionLabelText" Style="{StaticResource SecondaryCaptionTextStyle}" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="TotalValueText" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock x:Name="TotalLabelText" Style="{StaticResource SecondaryCaptionTextStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="IssuesSection" Spacing="12" Visibility="Collapsed">
                    <TextBlock x:Name="IssuesHeadingText" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Border Style="{StaticResource ListSurfaceBorderStyle}">
                        <ItemsRepeater x:Name="IssuesRepeater">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:LibraryIssueDisplayRecord">
                                    <Border Style="{StaticResource RowDividerStyle}">
                                        <Grid ColumnSpacing="12" MinHeight="56">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                FontSize="16"
                                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                Glyph="&#xE7BA;" />
                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                                <TextBlock
                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                    Text="{x:Bind Item}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Style="{StaticResource TertiaryCaptionTextStyle}"
                                                    Text="{x:Bind Issue}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="2"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                VerticalAlignment="Center">
                                                <Button
                                                    x:Name="RelinkButton"
                                                    Click="RelinkAction_Click"
                                                    Content="{x:Bind EffectiveRelinkLabel, Mode=OneTime}"
                                                    Tag="{x:Bind MediaFileId}"
                                                    Visibility="{x:Bind HasMediaFileVisibility, Mode=OneTime}"
                                                    Style="{StaticResource AccentControlButtonStyle}" />
                                                <Button
                                                    x:Name="IssueActionButton"
                                                    Click="IssueAction_Click"
                                                    Content="{x:Bind ActionLabel}"
                                                    Tag="{x:Bind MediaFileId}"
                                                    Style="{StaticResource SubtleControlButtonStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Border>
                </StackPanel>

                <controls:EmptyStateCard
                    x:Name="NoIssuesState"
                    Glyph="&#xE73E;"
                    Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
