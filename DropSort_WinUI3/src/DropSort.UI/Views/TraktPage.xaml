<Page
    x:Class="DropSort.UI.Views.TraktPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DropSort.UI.Controls"
    xmlns:views="using:DropSort.UI.Views"
    Background="Transparent">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Page Header, Status Pill, Sync Button -->
        <StackPanel
            Grid.Row="0"
            Padding="32,24,32,0"
            Spacing="16">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12">
                    <TextBlock
                        x:Name="PageTitleText"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="Trakt"
                        TextTrimming="CharacterEllipsis" />

                    <!-- Status Pill: Connected / Offline Cache / Disconnected -->
                    <Border
                        x:Name="StatusPill"
                        VerticalAlignment="Center"
                        Style="{StaticResource StatusPillStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Grid Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse x:Name="ConnectedDot" Fill="{ThemeResource SystemFillColorSuccessBrush}" Visibility="Collapsed" />
                                <Ellipse x:Name="SyncingDot" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="Collapsed" />
                                <Ellipse x:Name="DisconnectedDot" Fill="{ThemeResource SystemFillColorCautionBrush}" Visibility="Visible" />
                            </Grid>
                            <TextBlock x:Name="StatusPillText" Style="{StaticResource SecondaryCaptionTextStyle}" Text="Disconnected" />
                        </StackPanel>
                    </Border>

                    <TextBlock
                        x:Name="AccountInfoText"
                        VerticalAlignment="Center"
                        Style="{StaticResource SecondaryCaptionTextStyle}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Actions: Sync Now -->
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="SyncNowButton"
                        Click="SyncNowButton_Click"
                        Style="{StaticResource AccentControlButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="14"
                                Glyph="&#xE895;" />
                            <TextBlock x:Name="SyncNowButtonText" Text="Sync Now" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Sync Progress Bar -->
            <ProgressBar
                x:Name="SyncProgressBar"
                Height="2"
                IsIndeterminate="True"
                Visibility="Collapsed" />

            <!-- Error Banner -->
            <InfoBar
                x:Name="TraktErrorBanner"
                IsOpen="False"
                Severity="Error"
                IsClosable="True" />
        </StackPanel>

        <!-- Row 1: Resource ComboBox, Search Box, Items Count -->
        <Grid
            Grid.Row="1"
            Padding="32,16,32,12"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Resource selector: Watchlist / Watched Movies / Watched Shows / History / Custom Lists -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock
                    x:Name="ResourceLabelText"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Resource:" />
                <ComboBox
                    x:Name="ResourceSelector"
                    Width="240"
                    VerticalAlignment="Center"
                    SelectionChanged="ResourceSelector_SelectionChanged">
                    <ComboBoxItem x:Name="WatchlistItem" Content="Watchlist" Tag="watchlist" IsSelected="True" />
                    <ComboBoxItem x:Name="WatchedMoviesItem" Content="Watched Movies" Tag="watched_movies" />
                    <ComboBoxItem x:Name="WatchedShowsItem" Content="Watched Shows" Tag="watched_shows" />
                    <ComboBoxItem x:Name="HistoryItem" Content="Playback History" Tag="history" />
                </ComboBox>
            </StackPanel>

            <!-- Search Filter Box -->
            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="1"
                Width="300"
                HorizontalAlignment="Right"
                QueryIcon="Find"
                Style="{StaticResource PageSearchBoxStyle}"
                TextChanged="SearchBox_TextChanged" />

            <!-- Count display -->
            <TextBlock
                x:Name="ItemCountText"
                Grid.Column="2"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource SecondaryCaptionTextStyle}"
                Text="0 items" />
        </Grid>

        <!-- Row 2: Table Header Grid (Fixed Above Virtualized ListView) -->
        <Border
            Grid.Row="2"
            Margin="32,0,32,0"
            Padding="16,8"
            Background="{ThemeResource LayerFillColorAltBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1,1,1,0"
            CornerRadius="4,4,0,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="ColHeaderRankText"
                    Grid.Column="0"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="#" />
                <TextBlock
                    x:Name="ColHeaderTitleText"
                    Grid.Column="1"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Title" />
                <TextBlock
                    x:Name="ColHeaderTypeText"
                    Grid.Column="2"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Type" />
                <TextBlock
                    x:Name="ColHeaderWatchedText"
                    Grid.Column="3"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Trakt Status" />
                <TextBlock
                    x:Name="ColHeaderAvailabilityText"
                    Grid.Column="4"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Local Availability" />
                <TextBlock
                    x:Name="ColHeaderActionText"
                    Grid.Column="5"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Action" />
            </Grid>
        </Border>

        <!-- Row 3: Virtualized ListView -->
        <Border
            Grid.Row="3"
            Margin="32,0,32,24"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1,0,1,1"
            CornerRadius="0,0,4,4">
            <Grid>
                <!-- Loading Ring -->
                <ProgressRing
                    x:Name="LoadingRing"
                    Width="40"
                    Height="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="False"
                    Visibility="Collapsed" />

                <!-- Empty State -->
                <StackPanel
                    x:Name="EmptyStatePanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="Collapsed">
                    <FontIcon
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="36"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE9D9;" />
                    <TextBlock
                        x:Name="EmptyStateTitleText"
                        HorizontalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="No Trakt items found" />
                    <TextBlock
                        x:Name="EmptyStateSubtitleText"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SecondaryCaptionTextStyle}"
                        Text="No items in this view. Sync or choose another resource." />
                    <Button
                        x:Name="GoToSettingsButton"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Click="GoToSettingsButton_Click"
                        Content="Open Trakt Settings"
                        Style="{StaticResource SubtleControlButtonStyle}"
                        Visibility="Collapsed" />
                </StackPanel>

                <!-- Virtualized ListView with Grid-based ItemTemplate -->
                <ListView
                    x:Name="ItemsListView"
                    SelectionMode="None"
                    ItemsSource="{x:Bind DisplayedRows, Mode=OneTime}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="16,4" />
                            <Setter Property="MinHeight" Value="52" />
                            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="views:TraktRowModel">
                            <Grid ColumnSpacing="12" MinHeight="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>

                                <!-- Column 0: Index / Rank -->
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                    Text="{x:Bind IndexText, Mode=OneTime}" />

                                <!-- Column 1: Title, Year, Subtitle / Notes -->
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Title, Mode=OneTime}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Style="{StaticResource SecondaryCaptionTextStyle}"
                                            Text="{x:Bind YearText, Mode=OneTime}"
                                            Visibility="{x:Bind YearVisibility, Mode=OneTime}" />
                                    </StackPanel>
                                    <TextBlock
                                        Style="{StaticResource TertiaryCaptionTextStyle}"
                                        Text="{x:Bind SubtitleText, Mode=OneTime}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{x:Bind SubtitleVisibility, Mode=OneTime}" />
                                </StackPanel>

                                <!-- Column 2: Media Type -->
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryBodyTextStyle}"
                                    Text="{x:Bind KindText, Mode=OneTime}" />

                                <!-- Column 3: Watched Badge -->
                                <Border
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Visibility="{x:Bind WatchedBadgeVisibility, Mode=OneTime}"
                                    Background="{ThemeResource LayerFillColorAltBrush}"
                                    BorderBrush="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    Padding="8,3">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon
                                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                                            FontSize="10"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Glyph="&#xE73E;" />
                                        <TextBlock
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Text="{x:Bind WatchedBadgeText, Mode=OneTime}" />
                                    </StackPanel>
                                </Border>

                                <!-- Column 4: Local Availability Badge -->
                                <Border
                                    Grid.Column="4"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource LayerFillColorAltBrush}"
                                    BorderBrush="{x:Bind AvailabilityBrush, Mode=OneTime}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    Padding="8,3">
                                    <TextBlock
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{x:Bind AvailabilityBrush, Mode=OneTime}"
                                        Text="{x:Bind AvailabilityBadgeText, Mode=OneTime}" />
                                </Border>

                                <!-- Column 5: Action Button -->
                                <Button
                                    Grid.Column="5"
                                    VerticalAlignment="Center"
                                    Content="{x:Bind ActionButtonText, Mode=OneTime}"
                                    Click="DetailsButton_Click"
                                    Tag="{x:Bind}"
                                    Visibility="{x:Bind NavigateButtonVisibility, Mode=OneTime}"
                                    Style="{StaticResource SubtleControlButtonStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
