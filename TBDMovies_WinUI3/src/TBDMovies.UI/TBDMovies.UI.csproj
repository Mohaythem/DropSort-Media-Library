<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>TBDMovies.UI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WindowsPackageType>None</WindowsPackageType>
    <AppxMSBuildToolsPath Condition="'$(AppxMSBuildToolsPath)' == '' and exists('C:\Program Files\Microsoft Visual Studio\18\Community\MSBuild\Microsoft\VisualStudio\v18.0\AppxPackage\')">C:\Program Files\Microsoft Visual Studio\18\Community\MSBuild\Microsoft\VisualStudio\v18.0\AppxPackage\</AppxMSBuildToolsPath>
    <AppxMSBuildToolsPath Condition="'$(AppxMSBuildToolsPath)' == '' and exists('C:\Program Files\Microsoft Visual Studio\2022\Community\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\')">C:\Program Files\Microsoft Visual Studio\2022\Community\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\</AppxMSBuildToolsPath>

    <!--
      Desktop app identity for the unpackaged EXE and the installer. There is no authoritative legal
      publisher, so Company/Product use the project name. This is the 0.11.0 desktop release,
      not a 1.0 declaration. Numeric file/assembly versions follow Windows versioning.
    -->
    <ApplicationIcon>Assets\TBD-Movies.ico</ApplicationIcon>
    <Product>TBD Movies</Product>
    <AssemblyName>TBD-Movies</AssemblyName>
    <AssemblyTitle>TBD Movies</AssemblyTitle>
    <Company>TBD Movies</Company>
    <Authors>TBD Movies</Authors>
    <Version>0.11.1</Version>
    <AssemblyVersion>0.11.1.0</AssemblyVersion>
    <FileVersion>0.11.1.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Copyright>Copyright © TBD Movies</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.260224002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TBDMovies.Application\TBDMovies.Application.csproj" />
    <ProjectReference Include="..\TBDMovies.Infrastructure\TBDMovies.Infrastructure.csproj" />
    <ProjectReference Include="..\TBDMovies.FileSystem\TBDMovies.FileSystem.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\MovieDetails\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
