<!--
    TBDMovies semantic resource layer.

    Everything a native WinUI 3 ThemeResource already provides is consumed directly by the
    views (TextFillColorPrimaryBrush, CardBackgroundFillColorDefaultBrush, ControlCornerRadius,
    OverlayCornerRadius, the Windows type ramp, ...). This dictionary only adds the handful of
    application-level semantic values that have no built-in equivalent: the shared page
    geometry constants, the poster placeholder surfaces, the destructive-action tints and the
    optional Slate background tint.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared page geometry (effective pixels, 4 epx grid). -->
    <x:Double x:Key="PageContentMaxWidth">1040</x:Double>
    <x:Double x:Key="PageSearchMaxWidth">320</x:Double>
    <x:Double x:Key="AddMediaContentMaxWidth">1440</x:Double>
    <x:Double x:Key="CheckLibraryContentMaxWidth">640</x:Double>
    <x:Double x:Key="CheckLibraryWideMaxWidth">760</x:Double>
    <x:Double x:Key="ProseMaxWidth">760</x:Double>
    <x:Double x:Key="EmptyStateMaxWidth">560</x:Double>
    <x:Double x:Key="FileDetailsFlyoutWidth">420</x:Double>
    <x:Double x:Key="ControlRowHeight">36</x:Double>
    <x:Double x:Key="CompactControlHeight">32</x:Double>

    <!--
        Media card geometry. One poster viewport for the whole app: 180 x 270 epx, the exact 2:3
        poster ratio, declared on both axes so a real image (UniformToFill) and the missing-poster
        placeholder occupy the identical rectangle on Home, Library, My Lists and every search
        result. The title reserves two lines of the BodyStrong ramp (2 x 20 epx) so every row lines
        up whether a title wraps or not.

        Cell size = card + the item container's chrome. The container adds 4 epx padding on each
        side (the outer spacing the selection stroke sits in) plus its 2 epx stroke, so 12 epx on
        each axis, then the inter-card gutter (8 epx across, 16 epx down).
    -->
    <x:Double x:Key="MediaCardPosterWidth">180</x:Double>
    <x:Double x:Key="MediaCardPosterHeight">270</x:Double>
    <x:Double x:Key="MediaCardTitleHeight">40</x:Double>
    <x:Double x:Key="MediaCardItemWidth">192</x:Double>
    <x:Double x:Key="MediaCardItemHeight">346</x:Double>
    <x:Double x:Key="ShowCardItemHeight">364</x:Double>
    <x:Double x:Key="LibraryHorizontalFallbackCellWidth">332</x:Double>
    <x:Double x:Key="LibraryHorizontalCardMinWidth">320</x:Double>
    <x:Double x:Key="LibraryHorizontalCardMaxWidth">420</x:Double>
    <x:Double x:Key="LibraryHorizontalCardHeight">200</x:Double>
    <x:Double x:Key="LibraryHorizontalCellHeight">212</x:Double>
    <x:Double x:Key="LibraryHorizontalGap">12</x:Double>
    <x:Double x:Key="LibraryHorizontalPosterWidth">96</x:Double>
    <x:Double x:Key="LibraryHorizontalPosterHeight">144</x:Double>
    <x:Double x:Key="DetailsPosterWidth">180</x:Double>
    <x:Double x:Key="DetailsPosterHeight">270</x:Double>

    <Thickness x:Key="PageContentPadding">32,32,32,48</Thickness>
    <Thickness x:Key="PageContentPaddingCompact">24,24,24,40</Thickness>

    <!--
        Shell surfaces and NavigationView selected-state strength.

        The shell reads as two layers: the pane is the receding surface and the content area is the
        elevated one, so ShellPaneBackgroundBrush darkens what is behind it and
        ShellContentBackgroundBrush lifts it. Both are neutral overlays rather than opaque colours,
        which is what keeps the pair theme-aware: the same two values sit on the Light surface, the
        Dark surface and the Slate tint, so Slate stays slate-tinted instead of collapsing onto a
        hard-coded panel colour. The expanded inline pane stays transparent to preserve those layers.
        The default pane brush is opaque because compact/minimal panes overlay page content.

        The rest are NavigationView's own lightweight-styling keys, overridden application-wide so
        the shell keeps the stock template, the stock accent selection indicator
        (NavigationViewSelectionIndicatorForeground is deliberately NOT overridden - the default
        already is AccentFillColorDefaultBrush) and every stock hover, pressed and focus visual. The
        fill behind the active item is a light overlay in the dark themes and a dark one in Light, so
        it keeps reading as a plate now that the pane underneath it is the darkest shell surface.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <!-- Dark uses a neutral near-black surface. Slate applies its tinted palette locally
                 from MainWindow, so these values must not be shared with the Slate surface. -->
            <SolidColorBrush x:Key="LandscapeCardTextBrush" Color="#FFF8F9FB" />
            <SolidColorBrush x:Key="LandscapeCardSecondaryTextBrush" Color="#FFE1E6EB" />
            <!-- Artwork badges sit over poster imagery. Keep a solid scrim so text remains legible. -->
            <SolidColorBrush x:Key="ArtworkBadgeBackgroundBrush" Color="#CC080F16" />
            <SolidColorBrush x:Key="ArtworkBadgeForegroundBrush" Color="#FFF8F9FB" />
            <LinearGradientBrush x:Key="LandscapeCardScrimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#10080F16" />
                <GradientStop Offset="0.35" Color="#33080F16" />
                <GradientStop Offset="0.65" Color="#CC080F16" />
                <GradientStop Offset="1" Color="#F5080F16" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="HeroBackdropScrimBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0.0" Color="#00111111" />
                <GradientStop Offset="0.45" Color="#66111111" />
                <GradientStop Offset="0.80" Color="#D9111111" />
                <GradientStop Offset="1.0" Color="#FF111111" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="ShellPaneBackgroundBrush" Color="#3D000000" />
            <SolidColorBrush x:Key="ShellContentBackgroundBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="ShellPaneSeparatorBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{ThemeResource SolidBackgroundFillColorBase}" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />

            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#40FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#4DFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#FFFFFFFF" />

            <LinearGradientBrush x:Key="PosterMoviePlaceholderBrush" StartPoint="0,0" EndPoint="0.85,1">
                <GradientStop Offset="0" Color="#FF3A5866" />
                <GradientStop Offset="1" Color="#FF2B2B2B" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PosterShowPlaceholderBrush" StartPoint="0,0" EndPoint="0.85,1">
                <GradientStop Offset="0" Color="#FF46425D" />
                <GradientStop Offset="1" Color="#FF2B2B2B" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="PosterGlyphForegroundBrush" Color="#61FFFFFF" />
            <SolidColorBrush x:Key="SlateBackgroundBrush" Color="#FF1F2933" />
            <SolidColorBrush x:Key="DangerControlBackgroundBrush" Color="#14FF99A4" />
            <SolidColorBrush x:Key="DangerControlBorderBrush" Color="#61FF99A4" />
            <SolidColorBrush x:Key="DangerCardStrokeBrush" Color="#61FF99A4" />
            <SolidColorBrush x:Key="AccentControlBorderBrush" Color="#7A60CDFF" />

            <!-- Figma Approved Theme Tokens: Slate / Dark Default -->
            <SolidColorBrush x:Key="FigmaSurfaceAppBrush" Color="#FF111111" />
            <SolidColorBrush x:Key="FigmaSurfaceSecondaryBrush" Color="#FF181818" />
            <SolidColorBrush x:Key="FigmaSurfaceControlBrush" Color="#FF242424" />
            <SolidColorBrush x:Key="FigmaBorderDefaultBrush" Color="#FF454545" />
            <SolidColorBrush x:Key="FigmaTextPrimaryBrush" Color="#FFF5F5F5" />
            <SolidColorBrush x:Key="FigmaTextSecondaryBrush" Color="#FFCACACA" />
            <SolidColorBrush x:Key="FigmaTextTertiaryBrush" Color="#FF9E9E9E" />
            <SolidColorBrush x:Key="FigmaAccentButtonBrush" Color="#FF44C4F6" />
            <SolidColorBrush x:Key="FigmaAccentForegroundBrush" Color="#FF111111" />
            <SolidColorBrush x:Key="FigmaAccentSelectedSurfaceBrush" Color="#FF203E4B" />
            <SolidColorBrush x:Key="FigmaStatusAvailableBrush" Color="#FFA5C8AD" />
            <SolidColorBrush x:Key="FigmaStatusStorageGoldBrush" Color="#FFE6BB70" />
            <SolidColorBrush x:Key="ArtworkViewerFrameBrush" Color="#FF000000" />
            <SolidColorBrush x:Key="ArtworkViewerCanvasBrush" Color="#FF000000" />

            <!-- Unified UI Kit Semantic Badge Tokens: Dark -->
            <SolidColorBrush x:Key="BadgeSuccessBackgroundBrush" Color="#1F34D399" />
            <SolidColorBrush x:Key="BadgeSuccessForegroundBrush" Color="#FF34D399" />
            <SolidColorBrush x:Key="BadgeSuccessBorderBrush" Color="#4D34D399" />
            <SolidColorBrush x:Key="BadgeCautionBackgroundBrush" Color="#1FFBBF24" />
            <SolidColorBrush x:Key="BadgeCautionForegroundBrush" Color="#FFFBBF24" />
            <SolidColorBrush x:Key="BadgeCautionBorderBrush" Color="#4DFBBF24" />
            <SolidColorBrush x:Key="BadgeCriticalBackgroundBrush" Color="#1FF87171" />
            <SolidColorBrush x:Key="BadgeCriticalForegroundBrush" Color="#FFF87171" />
            <SolidColorBrush x:Key="BadgeCriticalBorderBrush" Color="#4DF87171" />
            <SolidColorBrush x:Key="BadgeAccentBackgroundBrush" Color="#1F38BDF8" />
            <SolidColorBrush x:Key="BadgeAccentForegroundBrush" Color="#FF38BDF8" />
            <SolidColorBrush x:Key="BadgeAccentBorderBrush" Color="#4D38BDF8" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="LandscapeCardTextBrush" Color="#FFF8F9FB" />
            <SolidColorBrush x:Key="LandscapeCardSecondaryTextBrush" Color="#FFE1E6EB" />
            <!-- White artwork text needs a dark, opaque enough plate in the Light theme. -->
            <SolidColorBrush x:Key="ArtworkBadgeBackgroundBrush" Color="#D9000000" />
            <SolidColorBrush x:Key="ArtworkBadgeForegroundBrush" Color="#FFFFFFFF" />
            <LinearGradientBrush x:Key="LandscapeCardScrimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#10080F16" />
                <GradientStop Offset="0.35" Color="#33080F16" />
                <GradientStop Offset="0.65" Color="#CC080F16" />
                <GradientStop Offset="1" Color="#F5080F16" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="HeroBackdropScrimBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0.0" Color="#00F8F9FA" />
                <GradientStop Offset="0.45" Color="#66F8F9FA" />
                <GradientStop Offset="0.80" Color="#D9F8F9FA" />
                <GradientStop Offset="1.0" Color="#FFF8F9FA" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="ShellPaneBackgroundBrush" Color="#17000000" />
            <SolidColorBrush x:Key="ShellContentBackgroundBrush" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="ShellPaneSeparatorBrush" Color="#1F000000" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{ThemeResource SolidBackgroundFillColorBase}" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />

            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#24000000" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#2E000000" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#1A000000" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#0F000000" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#0A000000" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#E4000000" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#E4000000" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#E4000000" />

            <LinearGradientBrush x:Key="PosterMoviePlaceholderBrush" StartPoint="0,0" EndPoint="0.85,1">
                <GradientStop Offset="0" Color="#FFB9D4EB" />
                <GradientStop Offset="1" Color="#FFFAFAFA" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PosterShowPlaceholderBrush" StartPoint="0,0" EndPoint="0.85,1">
                <GradientStop Offset="0" Color="#FFE2DDFA" />
                <GradientStop Offset="1" Color="#FFFAFAFA" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="PosterGlyphForegroundBrush" Color="#72000000" />
            <SolidColorBrush x:Key="SlateBackgroundBrush" Color="#FFF3F3F3" />
            <SolidColorBrush x:Key="DangerControlBackgroundBrush" Color="#14C42B1C" />
            <SolidColorBrush x:Key="DangerControlBorderBrush" Color="#61C42B1C" />
            <SolidColorBrush x:Key="DangerCardStrokeBrush" Color="#61C42B1C" />
            <SolidColorBrush x:Key="AccentControlBorderBrush" Color="#7A0067C0" />

            <!-- Figma Approved Theme Tokens: Light Theme -->
            <SolidColorBrush x:Key="FigmaSurfaceAppBrush" Color="#FFF8F9FA" />
            <SolidColorBrush x:Key="FigmaSurfaceSecondaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="FigmaSurfaceControlBrush" Color="#FFF0F2F5" />
            <SolidColorBrush x:Key="FigmaBorderDefaultBrush" Color="#FFD0D7DE" />
            <SolidColorBrush x:Key="FigmaTextPrimaryBrush" Color="#FF1A2026" />
            <SolidColorBrush x:Key="FigmaTextSecondaryBrush" Color="#FF57606A" />
            <SolidColorBrush x:Key="FigmaTextTertiaryBrush" Color="#FF6E7781" />
            <SolidColorBrush x:Key="FigmaAccentButtonBrush" Color="#FF0078D4" />
            <SolidColorBrush x:Key="FigmaAccentForegroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="FigmaAccentSelectedSurfaceBrush" Color="#FFDDF4FF" />
            <SolidColorBrush x:Key="FigmaStatusAvailableBrush" Color="#FF2DA44E" />
            <SolidColorBrush x:Key="FigmaStatusStorageGoldBrush" Color="#FFBF8700" />
            <SolidColorBrush x:Key="ArtworkViewerFrameBrush" Color="#FF202020" />
            <SolidColorBrush x:Key="ArtworkViewerCanvasBrush" Color="#FF202020" />

            <!-- Unified UI Kit Semantic Badge Tokens: Light -->
            <SolidColorBrush x:Key="BadgeSuccessBackgroundBrush" Color="#14059669" />
            <SolidColorBrush x:Key="BadgeSuccessForegroundBrush" Color="#FF059669" />
            <SolidColorBrush x:Key="BadgeSuccessBorderBrush" Color="#4D059669" />
            <SolidColorBrush x:Key="BadgeCautionBackgroundBrush" Color="#14D97706" />
            <SolidColorBrush x:Key="BadgeCautionForegroundBrush" Color="#FFD97706" />
            <SolidColorBrush x:Key="BadgeCautionBorderBrush" Color="#4DD97706" />
            <SolidColorBrush x:Key="BadgeCriticalBackgroundBrush" Color="#14DC2626" />
            <SolidColorBrush x:Key="BadgeCriticalForegroundBrush" Color="#FFDC2626" />
            <SolidColorBrush x:Key="BadgeCriticalBorderBrush" Color="#4DDC2626" />
            <SolidColorBrush x:Key="BadgeAccentBackgroundBrush" Color="#140284C7" />
            <SolidColorBrush x:Key="BadgeAccentForegroundBrush" Color="#FF0284C7" />
            <SolidColorBrush x:Key="BadgeAccentBorderBrush" Color="#4D0284C7" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="LandscapeCardTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LandscapeCardSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ArtworkBadgeBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ArtworkBadgeForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="LandscapeCardScrimBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HeroBackdropScrimBrush" Color="Transparent" />

            <SolidColorBrush x:Key="ShellPaneBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ShellContentBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ShellPaneSeparatorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />

            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />

            <SolidColorBrush x:Key="PosterMoviePlaceholderBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="PosterShowPlaceholderBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="PosterGlyphForegroundBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="SlateBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DangerControlBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="DangerControlBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="DangerCardStrokeBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="AccentControlBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />

            <!-- Figma Approved Theme Tokens: HighContrast -->
            <SolidColorBrush x:Key="FigmaSurfaceAppBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FigmaSurfaceSecondaryBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FigmaSurfaceControlBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="FigmaBorderDefaultBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FigmaTextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FigmaTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FigmaTextTertiaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FigmaAccentButtonBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FigmaAccentForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="FigmaAccentSelectedSurfaceBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FigmaStatusAvailableBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FigmaStatusStorageGoldBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ArtworkViewerFrameBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ArtworkViewerCanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <!-- Unified UI Kit Semantic Badge Tokens: HighContrast -->
            <SolidColorBrush x:Key="BadgeSuccessBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BadgeSuccessForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="BadgeSuccessBorderBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="BadgeCautionBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BadgeCautionForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BadgeCautionBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BadgeCriticalBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BadgeCriticalForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BadgeCriticalBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BadgeAccentBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="BadgeAccentForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="BadgeAccentBorderBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
